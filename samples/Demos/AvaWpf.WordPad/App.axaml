<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="https://github.com/avawpf"
             x:Class="AvaWpf.WordPad.App"
             Name="AvaWpf WordPad"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <wpf:AvaWpfTheme Theme="Aero" />
    <wpf:AvaWpfControlsTheme />
    <wpf:AvaWpfRibbonTheme />
  </Application.Styles>
</Application>
