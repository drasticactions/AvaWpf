<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="https://github.com/avawpf"
             x:Class="AvaWpf.Gallery.Pages.TreesPage">
  <StackPanel Spacing="12">
    <TextBlock Classes="Subtitle" Text="Tree view" />
    <TreeView Width="260" Height="220" HorizontalAlignment="Left">
      <TreeViewItem Header="Desktop" IsExpanded="True">
        <TreeViewItem Header="My Documents" IsExpanded="True">
          <TreeViewItem Header="Letters" />
          <TreeViewItem Header="Reports" IsSelected="True" />
        </TreeViewItem>
        <TreeViewItem Header="My Computer">
          <TreeViewItem Header="Local Disk (C:)" />
          <TreeViewItem Header="CD Drive (D:)" />
        </TreeViewItem>
        <TreeViewItem Header="Network Places" />
        <TreeViewItem Header="Recycle Bin" IsEnabled="False" />
      </TreeViewItem>
    </TreeView>
  </StackPanel>
</UserControl>
