<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF Calendar.xaml CalendarButton. VisualStateManager states become pseudo-classes.
    WPF's NormalText presenter is PART_ContentPresenter, the name Avalonia's ContentControl looks for.
  -->
  <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">
    <Setter Property="Background" Value="{DynamicResource $F.Calendar.CalendarButton.Setter.Self.Background}" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Rectangle Name="SelectedBackground"
                     RadiusX="1"
                     RadiusY="1"
                     Opacity="0"
                     Fill="{TemplateBinding Background}" />
          <Rectangle Name="Background"
                     RadiusX="1"
                     RadiusY="1"
                     Opacity="0"
                     Fill="{TemplateBinding Background}">
            <Rectangle.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
              </Transitions>
            </Rectangle.Transitions>
          </Rectangle>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="1,0,1,1">
            <ContentPresenter.Foreground>
              <SolidColorBrush Color="{DynamicResource $F.Calendar.CalendarButton.SolidColorBrush#1.Color}" />
            </ContentPresenter.Foreground>
          </ContentPresenter>
          <Rectangle Name="CalendarButtonFocusVisual"
                     IsVisible="False"
                     IsHitTestVisible="False"
                     RadiusX="1"
                     RadiusY="1"
                     StrokeThickness="1"
                     Stroke="{DynamicResource $F.Calendar.CalendarButton.CalendarButtonFocusVisual.Stroke}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <!-- CommonStates. -->
    <Style Selector="^:pointerover /template/ Rectangle#Background">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^:pressed /template/ Rectangle#Background">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- SelectionStates. -->
    <Style Selector="^:selected /template/ Rectangle#SelectedBackground">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <!-- ActiveStates. -->
    <Style Selector="^:inactive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource $F.Invented.Calendar.CalendarButton.NormalText.Foreground.Inactive}" />
    </Style>
    <!-- CalendarButtonFocusStates, and the IsFocused trigger. -->
    <Style Selector="^:btnfocused /template/ Rectangle#CalendarButtonFocusVisual">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus /template/ Rectangle#CalendarButtonFocusVisual">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
