<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF Button.xaml: Button uses BaseButtonStyle (the family's _ButtonBase.axaml). Class toolbar: WPF
       ToolBar.ButtonStyleKey. -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button" BasedOn="{StaticResource $F.BaseButtonStyle}">
    <Style Selector="^.toolbar">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{DynamicResource $F.FocusVisualStyle}" />
      <Setter Property="Template" Value="{StaticResource $F.ToolBarButtonTemplate}" />
      <Style Selector="^:pointerover /template/ Border#Bd, ^:focus /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{DynamicResource $F.ToolBarButtonHoverBorder}" />
        <Setter Property="Background" Value="{DynamicResource $F.ToolBarButtonHover}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{DynamicResource $F.ToolBarButtonPressedBorder}" />
        <Setter Property="Background" Value="{DynamicResource $F.ToolBarButtonPressed}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
