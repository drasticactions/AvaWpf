<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- TableViewRow: the WPF ListViewItem in a GridView; no hover look. -->
  <ControlTheme x:Key="{x:Type TableViewRow}" TargetType="TableViewRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,1" />
    <Setter Property="FocusAdorner" Value="{DynamicResource $F.FocusVisualStyle}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                Classes.inactive="{Binding !$parent[ItemsControl].IsKeyboardFocusWithin}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                UseLayoutRounding="True">
          <Panel>
            <TableViewCellsPresenter Name="PART_CellsPresenter" />
            <!-- The cells come from PART_CellsPresenter; this empty presenter only registers. -->
            <ContentPresenter Name="PART_ContentPresenter" IsVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SystemColors.HighlightBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
      </Style>
      <Style Selector="^ /template/ Border#Bd.inactive">
        <Setter Property="Background" Value="{DynamicResource SystemColors.InactiveSelectionHighlightBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemColors.InactiveSelectionHighlightTextBrush}" />
      </Style>
    </Style>
    <Style Selector="^:disabled /template/ Border#Bd">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
