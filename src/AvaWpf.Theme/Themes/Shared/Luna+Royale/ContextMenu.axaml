<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- WPF ContextMenu.xaml [[Luna.*, Royale.NormalColor]]; the items are submenu items sharing the icon and gesture
       columns. -->
  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <!-- Focusable: the ContextMenu takes the focus when it opens, so the arrow keys reach it. -->
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Background" Value="{DynamicResource SystemColors.MenuBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SystemFonts.MenuFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource SystemFonts.MenuFontSize}" />
    <Setter Property="FontStyle" Value="{DynamicResource SystemFonts.MenuFontStyle}" />
    <Setter Property="FontWeight" Value="{DynamicResource SystemFonts.MenuFontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.MenuTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemColors.ControlDarkBrush}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="WindowManagerAddShadowHint" Value="False" />
    <Setter Property="wpf:PopupAnimation.Kind" Value="{DynamicResource SystemParameters.MenuPopupAnimation}" />
    <Setter Property="Template">
      <ControlTemplate>
        <wpf:SystemDropShadowChrome Name="Shdw" Margin="0,0,5,5" UseLayoutRounding="True">
          <Border Name="ContextMenuBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer Name="ContextMenuScrollViewer" Theme="{StaticResource $F.MenuScrollViewer}">
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              Margin="{TemplateBinding Padding}"
                              KeyboardNavigation.TabNavigation="Continue"
                              Grid.IsSharedSizeScope="True" />
            </ScrollViewer>
          </Border>
        </wpf:SystemDropShadowChrome>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
