    <Style Selector="^:pointerover /template/ Path#BottomAccent">
      <Setter Property="Fill" Value="{DynamicResource $F.HorizontalSliderThumbBottomAccentHover}" />
    </Style>
    <Style Selector="^[Tag=Focused] /template/ Path#TopAccent">
      <Setter Property="Fill" Value="{DynamicResource $F.HorizontalSliderThumbTopAccentHover}" />
    </Style>
    <Style Selector="^[Tag=Focused] /template/ Path#BottomAccent">
      <Setter Property="Fill" Value="{DynamicResource $F.HorizontalSliderThumbBottomAccentHover}" />
    </Style>
    <Style Selector="^:pressed /template/ Path#TopAccent">
      <Setter Property="Fill" Value="{DynamicResource $F.HorizontalSliderThumbTopAccentPressed}" />
    </Style>
    <Style Selector="^:pressed /template/ Path#BottomAccent">
      <Setter Property="Fill" Value="{DynamicResource $F.HorizontalSliderThumbBottomAccentPressed}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#Background">
      <Setter Property="Fill" Value="{DynamicResource $F.Slider.HorizontalSliderDownThumbStyle.Background.Fill.IsEnabled_false}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#OuterBorder">
      <Setter Property="Stroke" Value="{DynamicResource $F.Slider.HorizontalSliderDownThumbStyle.OuterBorder.Stroke.IsEnabled_false}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#TopAccent">
      <Setter Property="Fill" Value="{DynamicResource $F.Slider.HorizontalSliderDownThumbStyle.TopAccent.Fill.IsEnabled_false}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#BottomAccent">
      <Setter Property="Fill" Value="Transparent" />
    </Style>
  </ControlTheme>

