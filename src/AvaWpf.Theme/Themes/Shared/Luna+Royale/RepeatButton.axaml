<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF Button.xaml: RepeatButton uses BaseButtonStyle (the family's _ButtonBase.axaml). -->
  <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton" BasedOn="{StaticResource $F.BaseButtonStyle}" />
</ResourceDictionary>
