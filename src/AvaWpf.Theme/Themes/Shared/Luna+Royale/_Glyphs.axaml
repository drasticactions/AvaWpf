<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Luna and Royale glyphs from WPF MenuItem.xaml (DownArrow, UpArrow, RightArrow, Checkmark); the left arrow is the
       right one mirrored. They forward to the geometry tokens. -->
  <wpf:ResourceAlias x:Key="$F.ArrowUpGeometry" Target="$F.UpArrow" />
  <wpf:ResourceAlias x:Key="$F.ArrowDownGeometry" Target="$F.DownArrow" />
  <wpf:ResourceAlias x:Key="$F.ArrowLeftGeometry" Target="$F.Invented.ArrowLeft" />
  <wpf:ResourceAlias x:Key="$F.ArrowRightGeometry" Target="$F.RightArrow" />
  <wpf:ResourceAlias x:Key="$F.CheckMarkGeometry" Target="$F.Checkmark" />
</ResourceDictionary>
