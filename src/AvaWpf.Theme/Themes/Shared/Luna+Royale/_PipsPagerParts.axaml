<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- PipsPager parts: $F.PipsPagerButton (a flat arrow button) and $F.PipsPagerItem (a round pip). -->
  <ControlTheme x:Key="$F.PipsPagerButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                UseLayoutRounding="True">
          <Path Name="Glyph"
                Fill="{TemplateBinding Foreground}"
                Data="{DynamicResource $F.ArrowLeftGeometry}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.next /template/ Path#Glyph">
      <Setter Property="Data" Value="{DynamicResource $F.ArrowRightGeometry}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Bd">
      <Setter Property="BorderBrush" Value="{DynamicResource $F.ToolBarButtonHoverBorder}" />
      <Setter Property="Background" Value="{DynamicResource $F.ToolBarButtonHover}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Bd">
      <Setter Property="BorderBrush" Value="{DynamicResource $F.ToolBarButtonPressedBorder}" />
      <Setter Property="Background" Value="{DynamicResource $F.ToolBarButtonPressed}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="$F.PipsPagerItem" TargetType="ListBoxItem">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Ellipse Name="Pip"
                   Width="6"
                   Height="6"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Fill="{DynamicResource SystemColors.GrayTextBrush}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse#Pip">
      <Setter Property="Fill" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Ellipse#Pip">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource SystemColors.HighlightBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#Pip">
      <Setter Property="Fill" Value="{DynamicResource SystemColors.ControlDarkBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
