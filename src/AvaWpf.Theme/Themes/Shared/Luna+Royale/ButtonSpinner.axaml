<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ButtonSpinner after the Windows XP up-down control: the family TextBox frame with two stacked scroll bar line
       buttons inside. -->
  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SystemColors.WindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource $F.ListBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="MinHeight" Value="21" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Border Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  MinHeight="{TemplateBinding MinHeight}"
                  UseLayoutRounding="True">
            <DockPanel>
              <Grid Name="PART_SpinnerPanel"
                    TabIndex="2"
                    DockPanel.Dock="Right"
                    Width="15"
                    RowDefinitions="*,*"
                    IsVisible="{TemplateBinding ShowButtonSpinner}">
                <RepeatButton Name="PART_IncreaseButton"
                              Grid.Row="0"
                              Classes="up"
                              Theme="{StaticResource $F.ScrollBarLineButton}"
                              IsTabStop="False" />
                <RepeatButton Name="PART_DecreaseButton"
                              Grid.Row="1"
                              Classes="down"
                              Theme="{StaticResource $F.ScrollBarLineButton}"
                              IsTabStop="False" />
              </Grid>
              <ContentPresenter Name="PART_ContentPresenter"
                                TabIndex="1"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:left /template/ Grid#PART_SpinnerPanel">
      <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
      <Style Selector="^ /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SystemColors.ControlBrush}" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
