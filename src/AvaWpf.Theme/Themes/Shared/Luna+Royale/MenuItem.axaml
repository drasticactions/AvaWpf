<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF MenuItem.xaml MenuItem style [[Luna.*, Royale.NormalColor]]: a submenu item. The role templates are in
       _MenuItemTemplates.axaml; Menu gives its items the top-level role theme. -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem" BasedOn="{StaticResource $F.MenuItem.SubmenuHeader}" />
</ResourceDictionary>
