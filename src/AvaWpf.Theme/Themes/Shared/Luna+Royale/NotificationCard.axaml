<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- NotificationCard: the Windows XP tray balloon. It fades in over 200 ms and fades out when closing. -->
  <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Width" Value="300" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.InfoTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SystemColors.InfoBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemColors.WindowFrameBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontFamily" Value="{DynamicResource SystemFonts.StatusFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource SystemFonts.StatusFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
          <wpf:SystemDropShadowChrome Name="Shdw" Margin="5,5,5,10" CornerRadius="{TemplateBinding CornerRadius}">
            <Border Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <ContentPresenter Name="PART_ContentPresenter"
                                MinHeight="48"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </wpf:SystemDropShadowChrome>
        </LayoutTransformControl>
      </ControlTemplate>
    </Setter>
    <ControlTheme.Animations>
      <Animation Duration="0:0:0.2" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </ControlTheme.Animations>
    <Style Selector="^[IsClosing=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.2" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsClosed" Value="True" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
