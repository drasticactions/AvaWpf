<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- SelectableTextBlock (no WPF fragment): the classic TextBox selection and a Copy context menu. -->
  <MenuFlyout x:Key="$F.SelectableTextBlockContextFlyout">
    <MenuItem Header="_Copy"
              Command="{Binding $parent[SelectableTextBlock].Copy}"
              IsEnabled="{Binding $parent[SelectableTextBlock].CanCopy}"
              InputGesture="{x:Static TextBox.CopyGesture}" />
  </MenuFlyout>

  <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{DynamicResource SystemColors.HighlightBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
    <Style Selector="^[IsEnabled=True]">
      <Setter Property="Cursor" Value="IBeam" />
      <Setter Property="ContextFlyout" Value="{StaticResource $F.SelectableTextBlockContextFlyout}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
