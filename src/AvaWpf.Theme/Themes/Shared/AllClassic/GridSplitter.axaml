<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF GridSplitter.xaml, [[all classic themes]]. -->
  <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource SystemColors.ControlBrush}" />
    <Setter Property="PreviewContent">
      <Template>
        <Rectangle Fill="{DynamicResource $F.GridSplitter.GridSplitterPreviewStyle.Rectangle#1.Fill}" />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
