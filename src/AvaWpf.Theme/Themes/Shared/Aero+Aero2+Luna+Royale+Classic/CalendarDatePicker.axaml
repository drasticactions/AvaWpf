<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF DatePicker.xaml DatePicker and DatePickerTextBox styles, for Avalonia's CalendarDatePicker.
    VisualStateManager states become pseudo-classes. PART_TextBox is a TextBox with the $F.DatePickerTextBox theme.
    WPF creates the drop-down Calendar in code; Avalonia needs it in the template (PART_Calendar).
  -->

  <!-- DatePicker.xaml DropDownButtonTemplate. -->
  <ControlTheme x:Key="$F.DatePickerDropDownButton" TargetType="Button">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Grid Height="18"
                Width="19"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0"
                Background="{DynamicResource $F.DatePicker.DatePicker.Grid#2.Background}"
                FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20*" />
              <ColumnDefinition Width="20*" />
              <ColumnDefinition Width="20*" />
              <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="23*" />
              <RowDefinition Height="19*" />
              <RowDefinition Height="19*" />
              <RowDefinition Height="19*" />
            </Grid.RowDefinitions>
            <Border Name="Highlight"
                    Margin="-1"
                    Grid.ColumnSpan="4"
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource $F.DatePicker.DatePicker.Highlight.BorderBrush}"
                    Opacity="0"
                    CornerRadius="0,0,1,1" />
            <Border Name="Background"
                    Margin="0,-1,0,0"
                    Grid.ColumnSpan="4"
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource $F.DatePicker.DatePicker.Background.BorderBrush}"
                    Opacity="1"
                    CornerRadius=".5"
                    Background="{DynamicResource $F.DatePicker.DatePicker.Background.Background}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Border Name="BackgroundGradient"
                    Margin="0,-1,0,0"
                    Grid.ColumnSpan="4"
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource $F.DatePicker.DatePicker.BackgroundGradient.BorderBrush}"
                    Opacity="1"
                    CornerRadius=".5"
                    Background="{DynamicResource $F.DatePicker.DatePicker.BackgroundGradient.Background}" />
            <Rectangle Grid.ColumnSpan="4"
                       Grid.RowSpan="1"
                       StrokeThickness="1"
                       Stroke="{DynamicResource $F.DatePicker.DatePicker.Rectangle#1.Stroke}"
                       Fill="{DynamicResource $F.DatePicker.DatePicker.Rectangle#1.Fill}" />
            <Path HorizontalAlignment="Center"
                  Margin="4,3,4,3"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="50%,50%"
                  Grid.Column="0"
                  Grid.Row="1"
                  Fill="{DynamicResource $F.DatePicker.DatePicker.Path#1.Fill}"
                  Stretch="Fill"
                  Data="{DynamicResource $F.DatePicker.DatePicker.Path#1.Data}"
                  Grid.ColumnSpan="4"
                  Grid.RowSpan="3" />
            <Ellipse HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource $F.DatePicker.DatePicker.Ellipse#1.Fill}"
                     StrokeThickness="0"
                     Grid.ColumnSpan="4"
                     Width="3"
                     Height="3" />
            <Border Name="DisabledVisual"
                    Grid.ColumnSpan="4"
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource $F.DatePicker.DatePicker.DisabledVisual.BorderBrush}"
                    Opacity="0"
                    CornerRadius="0,0,.5,.5" />
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource $F.Invented.DatePicker.DatePicker.Background.Background.MouseOver}" />
      </Style>
      <Style Selector="^ /template/ Border#BackgroundGradient">
        <Setter Property="Background" Value="{DynamicResource $F.Invented.DatePicker.DatePicker.BackgroundGradient.Background.MouseOver}" />
      </Style>
    </Style>
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource $F.Invented.DatePicker.DatePicker.Background.Background.Pressed}" />
      </Style>
      <Style Selector="^ /template/ Border#Highlight">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ Border#BackgroundGradient">
        <Setter Property="Background" Value="{DynamicResource $F.Invented.DatePicker.DatePicker.BackgroundGradient.Background.Pressed}" />
      </Style>
    </Style>
  </ControlTheme>

  <!-- DatePicker.xaml DatePickerTextBox. -->
  <ControlTheme x:Key="$F.DatePickerTextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.WindowTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SystemColors.WindowBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SystemColors.HighlightBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="1"
                  Opacity="1">
            <Grid Name="WatermarkContent"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Border Name="ContentElement"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource $F.DatePicker.DatePickerTextBox.ContentElement.BorderBrush}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <Border Name="watermark_decorator"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource $F.DatePicker.DatePickerTextBox.watermark_decorator.BorderBrush}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                  </Transitions>
                </Border.Transitions>
                <TextBlock Name="PART_Watermark"
                           Text="{TemplateBinding PlaceholderText}"
                           Opacity="0"
                           Focusable="False"
                           IsHitTestVisible="False"
                           Padding="2" />
              </Border>
              <ScrollViewer Name="PART_ScrollViewer"
                            Margin="0"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                <TextPresenter Name="PART_TextPresenter"
                               Text="{TemplateBinding Text, Mode=TwoWay}"
                               CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                               CaretIndex="{TemplateBinding CaretIndex}"
                               SelectionStart="{TemplateBinding SelectionStart}"
                               SelectionEnd="{TemplateBinding SelectionEnd}"
                               TextAlignment="{TemplateBinding TextAlignment}"
                               TextWrapping="{TemplateBinding TextWrapping}"
                               LineHeight="{TemplateBinding LineHeight}"
                               LetterSpacing="{TemplateBinding LetterSpacing}"
                               PasswordChar="{TemplateBinding PasswordChar}"
                               RevealPassword="{TemplateBinding RevealPassword}"
                               SelectionBrush="{TemplateBinding SelectionBrush}"
                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                               CaretBrush="{TemplateBinding CaretBrush}"
                               Margin="2" />
              </ScrollViewer>
              <Border Name="FocusVisual"
                      BorderBrush="{DynamicResource $F.DatePicker.DatePickerTextBox.FocusVisual.BorderBrush}"
                      CornerRadius="1"
                      Opacity="0"
                      IsHitTestVisible="False" />
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <!-- CommonStates. -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#ContentElement">
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.DatePicker.DatePickerTextBox.ContentElement.BorderBrush.MouseOver}" />
      </Style>
      <Style Selector="^ /template/ Border#watermark_decorator">
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.DatePicker.DatePickerTextBox.watermark_decorator.BorderBrush.MouseOver}" />
      </Style>
    </Style>
    <!-- WatermarkStates. -->
    <Style Selector="^:empty">
      <Style Selector="^ /template/ Border#ContentElement">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^ /template/ TextBlock#PART_Watermark">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>
    <!-- FocusStates. -->
    <Style Selector="^:focus /template/ Border#FocusVisual">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CalendarDatePicker}" TargetType="CalendarDatePicker">
    <Setter Property="Foreground" Value="{DynamicResource $F.DatePicker.DatePicker.Setter.Self.Foreground}" />
    <Setter Property="IsTodayHighlighted" Value="True" />
    <Setter Property="SelectedDateFormat" Value="Short" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource $F.DatePicker.DatePicker.Setter.Self.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
          <Grid Name="PART_Root"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Name="PART_Button"
                    Theme="{StaticResource $F.DatePickerDropDownButton}"
                    Grid.Row="0"
                    Grid.Column="1"
                    Foreground="{TemplateBinding Foreground}"
                    Width="20"
                    Margin="3,0,3,0"
                    Focusable="False"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left" />
            <TextBox Name="PART_TextBox"
                     Theme="{StaticResource $F.DatePickerTextBox}"
                     Grid.Row="0"
                     Grid.Column="0"
                     Foreground="{TemplateBinding Foreground}"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch"
                     Focusable="{TemplateBinding Focusable}" />
            <Grid Name="PART_DisabledVisual"
                  Opacity="0"
                  IsHitTestVisible="False"
                  Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Row="0"
                         Grid.Column="0"
                         RadiusX="1"
                         RadiusY="1"
                         Fill="{DynamicResource $F.DatePicker.DatePicker.Rectangle#2.Fill}" />
              <Rectangle Grid.Row="0"
                         Grid.Column="1"
                         RadiusX="1"
                         RadiusY="1"
                         Fill="{DynamicResource $F.DatePicker.DatePicker.Rectangle#3.Fill}"
                         Height="18"
                         Width="19"
                         Margin="3,0,3,0" />
              <Popup Name="PART_Popup"
                     PlacementTarget="PART_TextBox"
                     Placement="BottomEdgeAlignedLeft"
                     IsLightDismissEnabled="True">
                <Calendar Name="PART_Calendar"
                          FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                          IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                          SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          DisplayDate="{TemplateBinding DisplayDate}"
                          DisplayDateStart="{TemplateBinding DisplayDateStart}"
                          DisplayDateEnd="{TemplateBinding DisplayDateEnd}" />
              </Popup>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled /template/ Grid#PART_DisabledVisual">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
