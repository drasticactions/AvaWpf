<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    TableViewColumnHeader as WPF GridViewColumnHeader, [[Aero.NormalColor]]; PART_Resizer is WPF's PART_HeaderGripper.
    Avalonia's column header is not a button, so the pressed look has no state; HeaderPressBorder is kept.
  -->
  <ControlTheme x:Key="Aero.GridViewColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Aero.GridViewColumnHeaderBorderBackground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
          <Rectangle HorizontalAlignment="Center" Width="1" Fill="{TemplateBinding Background}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Aero.GridViewColumnHeaderBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Aero.GridViewColumnHeaderBorderBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,0,2,0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid UseLayoutRounding="True">
          <Border Name="HeaderBorder"
                  BorderThickness="0,1,0,1"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Background="{TemplateBinding Background}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition MaxHeight="7" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Rectangle Name="UpperHighlight"
                         IsVisible="False"
                         Fill="{DynamicResource Aero.ListView.GridViewColumnHeader.UpperHighlight.Fill}" />
              <Border Grid.RowSpan="2" Padding="{TemplateBinding Padding}">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Margin="0,0,0,1"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
          </Border>
          <Border Name="HeaderHoverBorder" BorderThickness="1,0,1,1" Margin="1,1,0,0" />
          <Border Name="HeaderPressBorder" BorderThickness="1,1,1,0" Margin="1,0,0,1" />
          <Thumb Name="PART_Resizer"
                 Theme="{StaticResource Aero.GridViewColumnHeaderGripper}"
                 HorizontalAlignment="Right"
                 Margin="0,0,-9,0"
                 Cursor="SizeWestEast"
                 IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Column?.CanUserEffectivelyResize, FallbackValue=False}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#HeaderBorder">
        <Setter Property="Background" Value="{DynamicResource Aero.GridViewColumnHeaderHoverBackground}" />
      </Style>
      <Style Selector="^ /template/ Border#HeaderHoverBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.ListView.GridViewColumnHeader.HeaderHoverBorder.BorderBrush.IsMouseOver_true}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#UpperHighlight">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Thumb#PART_Resizer">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
