<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- MenuFlyoutPresenter as WPF ContextMenu.xaml, [[Aero.NormalColor]]. -->
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <!--
      Focusable so the flyout focuses the menu, not its first item: no item is highlighted until a key is pressed,
      as in a WPF ContextMenu opened with the mouse.
    -->
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Background" Value="{DynamicResource Aero.ContextMenu.ContextMenu.Setter.Self.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Aero.ContextMenu.ContextMenu.Setter.Self.BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.MenuTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SystemFonts.MenuFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource SystemFonts.MenuFontSize}" />
    <Setter Property="FontStyle" Value="{DynamicResource SystemFonts.MenuFontStyle}" />
    <Setter Property="FontWeight" Value="{DynamicResource SystemFonts.MenuFontWeight}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <wpf:SystemDropShadowChrome Name="Shdw"
                                    Classes.dropshadow="{DynamicResource SystemParameters.DropShadow}"
                                    UseLayoutRounding="True">
          <Border Name="LayoutRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer Name="ContextMenuScrollViewer" Margin="1,0" Theme="{StaticResource Aero.MenuScrollViewer}">
              <Grid>
                <Rectangle Fill="{DynamicResource Aero.ContextMenu.ContextMenu.Rectangle#1.Fill}"
                           HorizontalAlignment="Left"
                           Width="28"
                           Margin="1,2"
                           RadiusX="2" RadiusY="2" />
                <Rectangle HorizontalAlignment="Left"
                           Width="1"
                           Margin="29,2,0,2"
                           Fill="{DynamicResource Aero.ContextMenu.ContextMenu.Rectangle#2.Fill}" />
                <Rectangle HorizontalAlignment="Left"
                           Width="1"
                           Margin="30,2,0,2"
                           Fill="{DynamicResource Aero.ContextMenu.ContextMenu.Rectangle#3.Fill}" />
                <ItemsPresenter Name="PART_ItemsPresenter"
                                Margin="{TemplateBinding Padding}"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                KeyboardNavigation.TabNavigation="Continue"
                                Grid.IsSharedSizeScope="True" />
              </Grid>
            </ScrollViewer>
          </Border>
        </wpf:SystemDropShadowChrome>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ wpf|SystemDropShadowChrome#Shdw.dropshadow">
      <Setter Property="Margin" Value="0,0,5,5" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
