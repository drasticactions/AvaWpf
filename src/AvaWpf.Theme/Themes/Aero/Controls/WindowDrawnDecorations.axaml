<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!--
    Avalonia's drawn window decorations: the Aero WindowFrame under the client with its caption buttons on top.
    Windows 7 has no full-screen caption button, so PART_FullScreenButton stays hidden.
  -->
  <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="29" />
    <Setter Property="DefaultFrameThickness" Value="9,1,9,9" />
    <Setter Property="DefaultShadowThickness" Value="10" />
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>
          <WindowDrawnDecorationsContent.Underlay>
            <Panel Name="PART_UnderlayWrapper">
              <wpf:WindowFrame Name="PART_WindowBorder"
                               Classes="decorations"
                               IsHitTestVisible="False"
                               Title="{TemplateBinding Title}"
                               IsActive="{Binding $parent[Window].IsActive, FallbackValue=True}"
                               WindowState="{Binding $parent[Window].WindowState, FallbackValue=Normal}"
                               ShowIcon="False" />
              <Panel Name="PART_TitleBar"
                     VerticalAlignment="Top"
                     Height="{TemplateBinding TitleBarHeight}"
                     Background="Transparent"
                     IsVisible="{TemplateBinding HasTitleBar}"
                     WindowDecorationProperties.ElementRole="TitleBar" />
            </Panel>
          </WindowDrawnDecorationsContent.Underlay>
          <WindowDrawnDecorationsContent.Overlay>
            <Panel Name="PART_OverlayWrapper">
              <StackPanel Name="PART_OverlayPanel"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,10,10,0"
                          Orientation="Horizontal"
                          Spacing="{DynamicResource Aero.Invented.WindowFrame.ButtonSpacing}"
                          IsVisible="{TemplateBinding HasTitleBar}">
                <Button Name="PART_FullScreenButton"
                        Theme="{StaticResource Aero.WindowFrame.CaptionButton}"
                        IsVisible="False"
                        Content="{DynamicResource Aero.Invented.WindowFrame.MaximizeGlyph}"
                        WindowDecorationProperties.ElementRole="FullScreenButton" />
                <Button Name="PART_MinimizeButton"
                        Theme="{StaticResource Aero.WindowFrame.CaptionButton}"
                        Classes="minimize"
                        Classes.inactive="{Binding !$parent[Window].IsActive, FallbackValue=False}"
                        Content="{DynamicResource Aero.Invented.WindowFrame.MinimizeGlyph}"
                        WindowDecorationProperties.ElementRole="MinimizeButton" />
                <Button Name="PART_MaximizeButton"
                        Theme="{StaticResource Aero.WindowFrame.CaptionButton}"
                        Classes.inactive="{Binding !$parent[Window].IsActive, FallbackValue=False}"
                        Content="{DynamicResource Aero.Invented.WindowFrame.MaximizeGlyph}"
                        WindowDecorationProperties.ElementRole="MaximizeButton" />
                <Button Name="PART_CloseButton"
                        Theme="{StaticResource Aero.WindowFrame.CloseButton}"
                        Classes.inactive="{Binding !$parent[Window].IsActive, FallbackValue=False}"
                        Content="{DynamicResource Aero.Invented.WindowFrame.CloseGlyph}"
                        WindowDecorationProperties.ElementRole="CloseButton" />
              </StackPanel>
            </Panel>
          </WindowDrawnDecorationsContent.Overlay>
          <WindowDrawnDecorationsContent.FullscreenPopover>
            <Panel Height="{TemplateBinding DefaultTitleBarHeight}"
                   VerticalAlignment="Top"
                   Background="{DynamicResource Aero.Invented.WindowFrame.Caption.Background}"
                   WindowDecorationProperties.ElementRole="DecorationsElement">
              <TextBlock Text="{TemplateBinding Title}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0"
                         FontFamily="{DynamicResource SystemFonts.CaptionFontFamily}"
                         FontSize="{DynamicResource SystemFonts.CaptionFontSize}"
                         Foreground="{DynamicResource SystemColors.ActiveCaptionTextBrush}" />
              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,7,2,0"
                          Spacing="{DynamicResource Aero.Invented.WindowFrame.ButtonSpacing}">
                <Button Name="PART_PopoverFullScreenButton"
                        Theme="{StaticResource Aero.WindowFrame.CaptionButton}"
                        Content="{DynamicResource Aero.Invented.WindowFrame.RestoreGlyph}"
                        WindowDecorationProperties.ElementRole="FullScreenButton" />
                <Button Name="PART_PopoverCloseButton"
                        Theme="{StaticResource Aero.WindowFrame.CloseButton}"
                        Content="{DynamicResource Aero.Invented.WindowFrame.CloseGlyph}"
                        WindowDecorationProperties.ElementRole="CloseButton" />
              </StackPanel>
            </Panel>
          </WindowDrawnDecorationsContent.FullscreenPopover>
        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>

    <Style Selector="^:has-shadow /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-shadow /template/ wpf|WindowFrame#PART_WindowBorder">
      <Setter Property="IsShadowVisible" Value="False" />
    </Style>
    <Style Selector="^:has-shadow /template/ Panel#PART_OverlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <!-- An undecorated window (a ThemeWindow draws its own frame) keeps the decorations with no parts enabled. -->
    <Style Selector="^:not(:has-border):not(:has-titlebar) /template/ wpf|WindowFrame#PART_WindowBorder">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:maximized /template/ StackPanel#PART_OverlayPanel">
      <Setter Property="Margin" Value="0,6,2,0" />
    </Style>
    <Style Selector="^:maximized /template/ Button#PART_MaximizeButton">
      <Setter Property="Content" Value="{DynamicResource Aero.Invented.WindowFrame.RestoreGlyph}" />
    </Style>
    <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-fullscreen) /template/ Button#PART_PopoverFullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ StackPanel#PART_OverlayPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ Panel#PART_TitleBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ wpf|WindowFrame#PART_WindowBorder">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
