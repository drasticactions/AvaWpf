<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- CommandBarToggleButton as WPF ToolBar.ToggleButtonStyleKey, [[Aero.NormalColor]] brushes. -->
  <ControlTheme x:Key="{x:Type CommandBarToggleButton}" TargetType="CommandBarToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{DynamicResource Aero.FocusVisualStyle}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                UseLayoutRounding="True">
          <StackPanel Name="PART_LayoutRoot"
                      Spacing="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ContentPresenter Name="PART_IconPresenter"
                              Content="{TemplateBinding Icon}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" />
            <TextBlock Name="PART_Label"
                       Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <!-- The Button content, shown only when set (Avalonia's command bar buttons use Icon and Label). -->
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Aero.ToolBarButtonHoverBorder}" />
      <Setter Property="Background" Value="{DynamicResource Aero.ToolBarButtonChecked}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Border, ^:focus /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Aero.ToolBarButtonHoverBorder}" />
      <Setter Property="Background" Value="{DynamicResource Aero.ToolBarButtonHover}" />
    </Style>
    <Style Selector="^:pointerover:checked /template/ Border#PART_Border, ^:focus:checked /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Aero.ToolBarButtonPressedBorder}" />
      <Setter Property="Background" Value="{DynamicResource Aero.ToolBarButtonPressed}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Aero.ToolBarButtonPressedBorder}" />
      <Setter Property="Background" Value="{DynamicResource Aero.ToolBarButtonPressed}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="22" />
      <Style Selector="^ /template/ StackPanel#PART_LayoutRoot">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="0" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="2,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^ /template/ TextBlock#PART_Label">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="FontSize" Value="{DynamicResource SystemFonts.MenuFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
