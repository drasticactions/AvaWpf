<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF TreeViewItem.xaml ExpandCollapseToggleStyle, [[Aero.NormalColor]]: the rotated TreeArrow triangle. Trigger order is kept.
  -->
  <ControlTheme x:Key="Aero.TreeViewExpandCollapseToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Width="16"
                Height="16"
                Background="Transparent"
                Padding="5,5,5,5">
          <Path Name="ExpandPath"
                Fill="{DynamicResource Aero.TreeViewItem.TreeArrow.Static.Fill}"
                Stroke="{DynamicResource Aero.TreeViewItem.TreeArrow.Static.Stroke}"
                Data="{DynamicResource Aero.TreeArrow}"
                StrokeThickness="1"
                RenderTransformOrigin="0,0">
            <Path.RenderTransform>
              <RotateTransform Angle="135" CenterX="3" CenterY="3" />
            </Path.RenderTransform>
          </Path>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Path#ExpandPath">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" CenterX="3" CenterY="3" />
      </Setter>
      <Setter Property="Fill" Value="{DynamicResource Aero.TreeViewItem.TreeArrow.Static.Checked.Fill}" />
      <Setter Property="Stroke" Value="{DynamicResource Aero.TreeViewItem.TreeArrow.Static.Checked.Stroke}" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#ExpandPath">
      <Setter Property="Stroke" Value="{DynamicResource Aero.TreeViewItem.TreeArrow.MouseOver.Stroke}" />
      <Setter Property="Fill" Value="{DynamicResource Aero.TreeViewItem.TreeArrow.MouseOver.Fill}" />
    </Style>
    <Style Selector="^:pointerover:checked /template/ Path#ExpandPath">
      <Setter Property="Stroke" Value="{DynamicResource Aero.TreeViewItem.TreeArrow.MouseOver.Checked.Stroke}" />
      <Setter Property="Fill" Value="{DynamicResource Aero.TreeViewItem.TreeArrow.MouseOver.Checked.Fill}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
