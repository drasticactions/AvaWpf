<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!--
    NotificationCard: a Windows 7 balloon in the WPF ToolTip.xaml [[Aero.NormalColor]] look with a kind-colored top strip.
  -->
  <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Width" Value="350" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.InfoTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource Aero.ToolTipBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Aero.ToolTip.ToolTip.Setter.Self.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Aero.Invented.Notification.CornerRadius}" />
    <Setter Property="FontFamily" Value="{DynamicResource SystemFonts.StatusFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource SystemFonts.StatusFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
          <wpf:SystemDropShadowChrome Name="Shdw"
                                      Margin="5,5,5,10"
                                      Classes.dropshadow="{DynamicResource SystemParameters.DropShadow}"
                                      CornerRadius="{TemplateBinding CornerRadius}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <DockPanel>
                <Panel Name="PART_HeaderBar"
                       Height="4"
                       Background="{DynamicResource Aero.Invented.Notification.Information}"
                       DockPanel.Dock="Top" />
                <ContentPresenter Name="PART_ContentPresenter" MinHeight="48" Content="{TemplateBinding Content}" />
              </DockPanel>
            </Border>
          </wpf:SystemDropShadowChrome>
        </LayoutTransformControl>
      </ControlTemplate>
    </Setter>
    <ControlTheme.Animations>
      <Animation Duration="0:0:0.2" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </ControlTheme.Animations>
    <Style Selector="^ /template/ wpf|SystemDropShadowChrome#Shdw.dropshadow">
      <Setter Property="Margin" Value="5,5,0,5" />
    </Style>
    <Style Selector="^[IsClosing=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.4" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="99%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsClosed" Value="False" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsClosed" Value="True" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:information /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{DynamicResource Aero.Invented.Notification.Information}" />
    </Style>
    <Style Selector="^:success /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{DynamicResource Aero.Invented.Notification.Success}" />
    </Style>
    <Style Selector="^:warning /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{DynamicResource Aero.Invented.Notification.Warning}" />
    </Style>
    <Style Selector="^:error /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{DynamicResource Aero.Invented.Notification.Error}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
