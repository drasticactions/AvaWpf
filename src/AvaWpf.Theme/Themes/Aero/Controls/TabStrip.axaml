<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- TabStrip: the tab row of WPF TabControl.xaml [[Aero.NormalColor]] without the content panel. -->
  <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">
    <Setter Property="BorderBrush" Value="{DynamicResource Aero.TabControlNormalBorderBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}"
                UseLayoutRounding="True">
          <Panel>
            <Border Name="BaseLine"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{TemplateBinding BorderBrush}" />
            <ItemsPresenter Name="PART_ItemsPresenter"
                            Margin="2,2,2,0"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel />
      </ItemsPanelTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
