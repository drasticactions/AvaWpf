<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF Button.xaml, [[Aero.NormalColor]]: RepeatButton uses BaseButtonStyle. -->
  <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton" BasedOn="{StaticResource Aero.BaseButtonStyle}" />
</ResourceDictionary>
