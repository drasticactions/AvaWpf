<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- TableView cell as a WPF GridViewRowPresenter cell; the 2,0 padding matches the column header padding. -->
  <ControlTheme x:Key="{x:Type TableViewCell}" TargetType="TableViewCell">
    <Setter Property="Padding" Value="2,0" />
  </ControlTheme>
</ResourceDictionary>
