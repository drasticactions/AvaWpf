<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF ComboBoxItem.xaml, [[Aero.NormalColor]].
    Avalonia has no IsHighlighted: the item under the pointer and the selected item are highlighted.
  -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem" x:DataType="ComboBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="{Binding ((ComboBox)Parent).HorizontalContentAlignment, RelativeSource={RelativeSource Self}, FallbackValue=Left}" />
    <Setter Property="VerticalContentAlignment" Value="{Binding ((ComboBox)Parent).VerticalContentAlignment, RelativeSource={RelativeSource Self}, FallbackValue=Center}" />
    <Setter Property="Padding" Value="3,0,3,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{DynamicResource Aero.FocusVisualStyle}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                UseLayoutRounding="True">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected, ^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
      <Style Selector="^ /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SystemColors.HighlightBrush}" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
