<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!--
    The Windows 7 Basic window frame: opaque, no glass or blur.
    Colors and sizes: tools/wpf-tokens/invented/aero.toml (Aero.Invented.WindowFrame.*).
  -->
  <ControlTheme x:Key="Aero.WindowFrame.CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="{DynamicResource Aero.Invented.WindowFrame.ButtonWidth}" />
    <Setter Property="Height" Value="{DynamicResource Aero.Invented.WindowFrame.ButtonHeight}" />
    <Setter Property="Background" Value="{DynamicResource Aero.Invented.WindowFrame.Button.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Aero.Invented.WindowFrame.Glyph}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Aero.Invented.WindowFrame.Glyph.Outline}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="border" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <Border Name="highlight"
                  BorderBrush="{DynamicResource Aero.Invented.WindowFrame.Button.InnerHighlight}"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Path Name="glyph"
                  Data="{TemplateBinding Content}"
                  Fill="{TemplateBinding Foreground}"
                  Stroke="{TemplateBinding BorderBrush}"
                  StrokeThickness="1"
                  Stretch="None"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Aero.Invented.WindowFrame.Button.Hover.Background}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource Aero.Invented.WindowFrame.Button.Pressed.Background}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Aero.Invented.WindowFrame.Glyph.Disabled}" />
    </Style>
    <Style Selector="^.close">
      <Setter Property="Width" Value="{DynamicResource Aero.Invented.WindowFrame.CloseButtonWidth}" />
      <Setter Property="Background" Value="{DynamicResource Aero.Invented.WindowFrame.Close.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Aero.Invented.WindowFrame.Close.Glyph.Outline}" />
    </Style>
    <Style Selector="^.close:pointerover">
      <Setter Property="Background" Value="{DynamicResource Aero.Invented.WindowFrame.Close.Hover.Background}" />
    </Style>
    <Style Selector="^.close:pressed">
      <Setter Property="Background" Value="{DynamicResource Aero.Invented.WindowFrame.Close.Pressed.Background}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type wpf:WindowFrame}" TargetType="wpf:WindowFrame">
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.WindowTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="root">
          <Border Name="frame"
                  Background="{DynamicResource Aero.Invented.WindowFrame.Border.Background}"
                  BorderBrush="{DynamicResource Aero.Invented.WindowFrame.Outline}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Aero.Invented.WindowFrame.CornerRadius}"
                  UseLayoutRounding="True">
            <Border Name="highlight"
                    BorderBrush="{DynamicResource Aero.Invented.WindowFrame.Highlight}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Aero.Invented.WindowFrame.InnerCornerRadius}">
              <DockPanel>
                <Panel DockPanel.Dock="Top">
                  <Border Name="captionBackground"
                          Background="{DynamicResource Aero.Invented.WindowFrame.Caption.Background}"
                          CornerRadius="{DynamicResource Aero.Invented.WindowFrame.InnerCornerRadius}" />
                  <Grid Name="PART_Caption"
                        Height="{DynamicResource Aero.Invented.WindowFrame.CaptionHeight}"
                        Background="Transparent"
                        ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                    <Image Name="icon" Grid.Column="0" Source="{TemplateBinding Icon}" Width="16" Height="16" Margin="5,0,0,1" VerticalAlignment="Center" />
                    <!--
                      Caption slots (a RibbonWindow puts its Quick Access Toolbar and contextual tab headers here).
                      Empty areas are not hit, so they still drag the window through PART_Caption.
                    -->
                    <ContentPresenter Name="PART_CaptionContentPresenter" Grid.Column="1"
                                      Content="{TemplateBinding CaptionContent}"
                                      VerticalAlignment="Center"
                                      IsVisible="{TemplateBinding CaptionContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ContentPresenter Name="PART_CaptionOverlayPresenter" Grid.Column="2"
                                      Content="{TemplateBinding CaptionOverlay}"
                                      VerticalAlignment="Stretch"
                                      IsVisible="{TemplateBinding CaptionOverlay, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Name="title"
                               Grid.Column="3"
                               Text="{TemplateBinding Title}"
                               Margin="6,0,6,1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource SystemFonts.CaptionFontFamily}"
                               FontSize="{DynamicResource SystemFonts.CaptionFontSize}"
                               FontWeight="{DynamicResource SystemFonts.CaptionFontWeight}"
                               FontStyle="{DynamicResource SystemFonts.CaptionFontStyle}"
                               Foreground="{DynamicResource SystemColors.ActiveCaptionTextBrush}" />
                    <!-- The caption button group hangs from the top outline, 4 px in from the right edge. -->
                    <Border Name="buttons"
                            Grid.Column="4"
                            Margin="0,-1,4,0"
                            VerticalAlignment="Top"
                            BorderBrush="{DynamicResource Aero.Invented.WindowFrame.Button.Border}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="{DynamicResource Aero.Invented.WindowFrame.ButtonGroupCornerRadius}"
                            ClipToBounds="True">
                      <StackPanel Orientation="Horizontal">
                        <Button Name="PART_MinimizeButton"
                                Theme="{StaticResource Aero.WindowFrame.CaptionButton}"
                                CornerRadius="0,0,0,3"
                                Content="{DynamicResource Aero.Invented.WindowFrame.MinimizeGlyph}"
                                IsVisible="{TemplateBinding IsMinimizeButtonVisible}" />
                        <Rectangle Name="separator1"
                                   Width="1"
                                   Fill="{DynamicResource Aero.Invented.WindowFrame.Button.Separator}"
                                   IsVisible="{TemplateBinding IsMinimizeButtonVisible}" />
                        <Button Name="PART_MaximizeButton"
                                Theme="{StaticResource Aero.WindowFrame.CaptionButton}"
                                Content="{DynamicResource Aero.Invented.WindowFrame.MaximizeGlyph}"
                                IsVisible="{TemplateBinding IsMaximizeButtonVisible}" />
                        <Rectangle Name="separator2"
                                   Width="1"
                                   Fill="{DynamicResource Aero.Invented.WindowFrame.Button.Separator}"
                                   IsVisible="{TemplateBinding IsMaximizeButtonVisible}" />
                        <Button Name="PART_CloseButton"
                                Theme="{StaticResource Aero.WindowFrame.CaptionButton}"
                                Classes="close"
                                CornerRadius="0,0,3,0"
                                Content="{DynamicResource Aero.Invented.WindowFrame.CloseGlyph}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Panel>
                <Border Name="clientEdge"
                        Margin="6,0,6,6"
                        Background="{DynamicResource SystemColors.ControlBrush}"
                        BorderBrush="{DynamicResource Aero.Invented.WindowFrame.ClientEdge}"
                        BorderThickness="1">
                  <DockPanel>
                    <ContentPresenter Name="menu"
                                      DockPanel.Dock="Top"
                                      Content="{TemplateBinding MenuBar}"
                                      IsVisible="{TemplateBinding MenuBar, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" />
                  </DockPanel>
                </Border>
              </DockPanel>
            </Border>
          </Border>
          <!-- Resize borders: the 8 px frame edges and corners. -->
          <Panel Name="resize">
            <Border wpf:WindowFrame.ResizeEdge="North" Height="4" VerticalAlignment="Top" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="South" Height="8" VerticalAlignment="Bottom" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="West" Width="8" HorizontalAlignment="Left" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="East" Width="8" HorizontalAlignment="Right" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="NorthWest" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="NorthEast" Width="4" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="SouthWest" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="SouthEast" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" />
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:inactive">
      <Style Selector="^ /template/ Border#frame">
        <Setter Property="Background" Value="{DynamicResource Aero.Invented.WindowFrame.Border.Background.Inactive}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Invented.WindowFrame.Outline.Inactive}" />
      </Style>
      <Style Selector="^ /template/ Border#highlight">
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Invented.WindowFrame.Highlight.Inactive}" />
      </Style>
      <Style Selector="^ /template/ Border#captionBackground">
        <Setter Property="Background" Value="{DynamicResource Aero.Invented.WindowFrame.Caption.Background.Inactive}" />
      </Style>
      <Style Selector="^ /template/ Border#clientEdge">
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Invented.WindowFrame.ClientEdge.Inactive}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#title">
        <Setter Property="Foreground" Value="{DynamicResource SystemColors.InactiveCaptionTextBrush}" />
      </Style>
      <Style Selector="^ /template/ Border#buttons">
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Invented.WindowFrame.Button.Border.Inactive}" />
      </Style>
      <Style Selector="^ /template/ Button:not(:pointerover):not(:pressed)">
        <Setter Property="Background" Value="{DynamicResource Aero.Invented.WindowFrame.Button.Inactive.Background}" />
      </Style>
      <Style Selector="^ /template/ Button">
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Invented.WindowFrame.Glyph.Outline.Inactive}" />
      </Style>
    </Style>
    <Style Selector="^:noicon /template/ Image#icon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:shadow /template/ Border#frame">
      <Setter Property="Margin" Value="{DynamicResource Aero.Invented.WindowFrame.ShadowMargin}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Aero.Invented.WindowFrame.Shadow}" />
    </Style>
    <Style Selector="^:shadow /template/ Panel#resize">
      <Setter Property="Margin" Value="{DynamicResource Aero.Invented.WindowFrame.ShadowMargin}" />
    </Style>
    <Style Selector="^:maximized">
      <Style Selector="^ /template/ Border#frame">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="^ /template/ Border#highlight">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="^ /template/ Border#captionBackground">
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="^ /template/ Border#clientEdge">
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
      </Style>
      <Style Selector="^ /template/ Border#buttons">
        <Setter Property="Margin" Value="0,0,2,0" />
      </Style>
      <Style Selector="^ /template/ Panel#resize">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Button#PART_MaximizeButton">
        <Setter Property="Content" Value="{DynamicResource Aero.Invented.WindowFrame.RestoreGlyph}" />
      </Style>
    </Style>
    <Style Selector="^:tool">
      <Style Selector="^ /template/ Grid#PART_Caption">
        <Setter Property="Height" Value="{DynamicResource Aero.Invented.WindowFrame.ToolCaptionHeight}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#title">
        <Setter Property="FontFamily" Value="{DynamicResource SystemFonts.SmallCaptionFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SystemFonts.SmallCaptionFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource SystemFonts.SmallCaptionFontWeight}" />
      </Style>
      <Style Selector="^ /template/ Button#PART_MinimizeButton, ^ /template/ Button#PART_MaximizeButton, ^ /template/ Rectangle#separator1, ^ /template/ Rectangle#separator2">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Button#PART_CloseButton">
        <Setter Property="Width" Value="{DynamicResource Aero.Invented.WindowFrame.ToolCloseButtonWidth}" />
        <Setter Property="CornerRadius" Value="0,0,3,3" />
      </Style>
    </Style>
    <Style Selector="^:dialog /template/ Button#PART_CloseButton">
      <Setter Property="CornerRadius" Value="0,0,3,3" />
    </Style>
    <!-- Used by WindowDrawnDecorations, which draws its own caption buttons above the frame. -->
    <Style Selector="^.decorations /template/ Border#buttons">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.decorations /template/ Panel#resize">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
