<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- TextSelectionHandle: a Highlight-filled teardrop; the caret handle is the same drop turned 45 degrees. -->
  <DrawingImage x:Key="Aero.TextSelectionHandleDrawing">
    <DrawingImage.Drawing>
      <GeometryDrawing Brush="{DynamicResource SystemColors.HighlightBrush}">
        <GeometryDrawing.Geometry>
          <CombinedGeometry>
            <CombinedGeometry.Geometry1>
              <RectangleGeometry Rect="0,0,16,16" />
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
              <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
            </CombinedGeometry.Geometry2>
          </CombinedGeometry>
        </GeometryDrawing.Geometry>
        <GeometryDrawing.Pen>
          <Pen Thickness="0.5" Brush="{DynamicResource SystemColors.WindowTextBrush}" LineJoin="Round" />
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="Aero.TextCaretHandleDrawing">
    <DrawingImage.Drawing>
      <GeometryDrawing Brush="{DynamicResource SystemColors.HighlightBrush}">
        <GeometryDrawing.Geometry>
          <CombinedGeometry>
            <CombinedGeometry.Geometry1>
              <RectangleGeometry Rect="0,0,16,16">
                <RectangleGeometry.Transform>
                  <RotateTransform CenterX="16" Angle="-45" />
                </RectangleGeometry.Transform>
              </RectangleGeometry>
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
              <EllipseGeometry Center="16,22.7" RadiusX="16" RadiusY="16" />
            </CombinedGeometry.Geometry2>
          </CombinedGeometry>
        </GeometryDrawing.Geometry>
        <GeometryDrawing.Pen>
          <Pen Thickness="0.5" Brush="{DynamicResource SystemColors.WindowTextBrush}" LineJoin="Round" />
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <ControlTheme x:Key="{x:Type TextSelectionHandle}" TargetType="TextSelectionHandle">
    <Setter Property="Background" Value="{DynamicResource SystemColors.HighlightBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Padding="0,0,0,10" IsHitTestVisible="True" Background="Transparent">
            <Image Name="PART_HandlePathIcon"
                   Stretch="Uniform"
                   Cursor="Arrow"
                   Height="32"
                   Source="{StaticResource Aero.TextSelectionHandleDrawing}" />
          </Border>
          <Border Name="PART_Indicator"
                  Background="Transparent"
                  HorizontalAlignment="Center"
                  Width="1"
                  VerticalAlignment="Top"
                  Height="5" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:caret /template/ Image#PART_HandlePathIcon">
      <Setter Property="Source" Value="{StaticResource Aero.TextCaretHandleDrawing}" />
    </Style>
    <Style Selector="^:start /template/ Image#PART_HandlePathIcon">
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="-1" ScaleY="1" />
      </Setter>
    </Style>
    <Style Selector="^:caret /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:end /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:start /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
