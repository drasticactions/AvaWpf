<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Aero glyphs (WPF MenuItem.xaml and ComboBox.xaml arrows and Checkmark); they forward to the geometry tokens. -->
  <wpf:ResourceAlias x:Key="Aero.ArrowUpGeometry" Target="Aero.UpArrow" />
  <wpf:ResourceAlias x:Key="Aero.ArrowDownGeometry" Target="Aero.DownArrowGeometry" />
  <wpf:ResourceAlias x:Key="Aero.ArrowLeftGeometry" Target="Aero.Invented.LeftArrow" />
  <wpf:ResourceAlias x:Key="Aero.ArrowRightGeometry" Target="Aero.RightArrow" />
  <wpf:ResourceAlias x:Key="Aero.CheckMarkGeometry" Target="Aero.Checkmark" />
</ResourceDictionary>
