<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- DatePickerPresenter in the Aero ComboBox drop-down look: three looping columns and accept/dismiss buttons. -->
  <ControlTheme x:Key="{x:Type DatePickerPresenter}" TargetType="DatePickerPresenter">
    <Setter Property="Width" Value="296" />
    <Setter Property="MinWidth" Value="296" />
    <Setter Property="MaxHeight" Value="398" />
    <Setter Property="Background" Value="{DynamicResource SystemColors.WindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemColors.WindowFrameBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.WindowTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <wpf:SystemDropShadowChrome Name="Shdw" Classes.dropshadow="{DynamicResource SystemParameters.DropShadow}">
          <Border Name="Background"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  MaxHeight="398">
            <Grid Name="ContentRoot" RowDefinitions="*,Auto">
              <Grid Name="PART_PickerContainer">
                <Grid.Styles>
                  <Style Selector="DateTimePickerPanel > ListBoxItem">
                    <Setter Property="Theme" Value="{StaticResource Aero.DateTimePickerItem}" />
                  </Style>
                </Grid.Styles>
                <!-- Column definitions are set in code. -->
                <Panel Name="PART_MonthHost">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <DateTimePickerPanel Name="PART_MonthSelector" PanelType="Month" ItemHeight="22" ShouldLoop="True" />
                  </ScrollViewer>
                  <RepeatButton Name="PART_MonthUpButton" Theme="{StaticResource Aero.DateTimePickerUpButton}" />
                  <RepeatButton Name="PART_MonthDownButton" Theme="{StaticResource Aero.DateTimePickerDownButton}" />
                </Panel>
                <Panel Name="PART_DayHost">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <DateTimePickerPanel Name="PART_DaySelector" PanelType="Day" ItemHeight="22" ShouldLoop="True" />
                  </ScrollViewer>
                  <RepeatButton Name="PART_DayUpButton" Theme="{StaticResource Aero.DateTimePickerUpButton}" />
                  <RepeatButton Name="PART_DayDownButton" Theme="{StaticResource Aero.DateTimePickerDownButton}" />
                </Panel>
                <Panel Name="PART_YearHost">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <DateTimePickerPanel Name="PART_YearSelector" PanelType="Year" ItemHeight="22" ShouldLoop="False" />
                  </ScrollViewer>
                  <RepeatButton Name="PART_YearUpButton" Theme="{StaticResource Aero.DateTimePickerUpButton}" />
                  <RepeatButton Name="PART_YearDownButton" Theme="{StaticResource Aero.DateTimePickerDownButton}" />
                </Panel>
                <Rectangle Name="HighlightRect"
                           IsHitTestVisible="False"
                           ZIndex="-1"
                           Fill="{DynamicResource SystemColors.HighlightBrush}"
                           Grid.Column="0"
                           Grid.ColumnSpan="5"
                           VerticalAlignment="Center"
                           Height="22" />
                <Rectangle Name="PART_FirstSpacer"
                           Fill="{DynamicResource SystemColors.ControlDarkBrush}"
                           HorizontalAlignment="Center"
                           Width="1"
                           Grid.Column="1" />
                <Rectangle Name="PART_SecondSpacer"
                           Fill="{DynamicResource SystemColors.ControlDarkBrush}"
                           HorizontalAlignment="Center"
                           Width="1"
                           Grid.Column="3" />
              </Grid>
              <Grid Name="AcceptDismissGrid" Grid.Row="1" ColumnDefinitions="*,*">
                <Rectangle Height="1"
                           VerticalAlignment="Top"
                           Fill="{DynamicResource SystemColors.ControlDarkBrush}"
                           Grid.ColumnSpan="2" />
                <Button Name="PART_AcceptButton"
                        Grid.Column="0"
                        Theme="{StaticResource Aero.DateTimePickerButton}"
                        HorizontalAlignment="Stretch">
                  <Path Stroke="{Binding $parent[Button].Foreground}"
                        StrokeLineCap="Round"
                        StrokeThickness="1.5"
                        Data="M0.5,4.5 3.5,7.5 9.5,1.5" />
                </Button>
                <Button Name="PART_DismissButton"
                        Grid.Column="1"
                        Theme="{StaticResource Aero.DateTimePickerButton}"
                        HorizontalAlignment="Stretch">
                  <Path Stroke="{Binding $parent[Button].Foreground}"
                        StrokeLineCap="Round"
                        StrokeThickness="1.5"
                        Data="M1,1 8,8 M1,8 8,1" />
                </Button>
              </Grid>
            </Grid>
          </Border>
        </wpf:SystemDropShadowChrome>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ wpf|SystemDropShadowChrome#Shdw.dropshadow">
      <Setter Property="Margin" Value="0,0,5,5" />
    </Style>
    <Style Selector="^ /template/ Panel">
      <Style Selector="^:pointerover RepeatButton">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
