<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF Button.xaml: ToggleButton uses BaseButtonStyle (_ButtonBase.axaml). ToggleButton.toolbar is WPF
       ToolBar.ToggleButtonStyleKey [[Classic]]. -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource Classic.BaseButtonStyle}">
    <Style Selector="^.toolbar">
      <Setter Property="FocusAdorner" Value="{DynamicResource Classic.FocusVisualStyle}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  UseLayoutRounding="True">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{DynamicResource Classic.ToolBarButtonHoverBorder}" />
        <Setter Property="Background" Value="{DynamicResource Classic.ToolBarButtonChecked}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{DynamicResource Classic.ToolBarButtonHoverBorder}" />
        <Setter Property="Background" Value="{DynamicResource Classic.ToolBarButtonHover}" />
      </Style>
      <Style Selector="^:focus /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{DynamicResource Classic.ToolBarButtonHoverBorder}" />
        <Setter Property="Background" Value="{DynamicResource Classic.ToolBarButtonHover}" />
      </Style>
      <Style Selector="^:pointerover:checked /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{DynamicResource Classic.ToolBarButtonPressedBorder}" />
        <Setter Property="Background" Value="{DynamicResource Classic.ToolBarButtonPressed}" />
      </Style>
      <Style Selector="^:focus:checked /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{DynamicResource Classic.ToolBarButtonPressedBorder}" />
        <Setter Property="Background" Value="{DynamicResource Classic.ToolBarButtonPressed}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{DynamicResource Classic.ToolBarButtonPressedBorder}" />
        <Setter Property="Background" Value="{DynamicResource Classic.ToolBarButtonPressed}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
      </Style>
    </Style>
    <!-- WPF ToggleButton style, high contrast and checked: a flat Highlight border, HighlightText while focused. -->
    <Style Selector="^:highcontrast:checked:not(.toolbar)">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemColors.HighlightBrush}" />
    </Style>
    <Style Selector="^:highcontrast:checked:focus:not(.toolbar)">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
