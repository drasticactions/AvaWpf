<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- WPF ComboBox.xaml [[Classic]], with ComboBoxEditableTemplate and ComboBox.toolbar (ToolBar.xaml
       ComboBoxStyleKey). Avalonia opens the drop-down on its own pointer handling, so the drop-down button only shows
       the state (not hit-testable, IsChecked follows IsDropDownOpen). -->
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="FocusAdorner" Value="{DynamicResource Classic.ComboBoxFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.WindowTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SystemColors.WindowBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="MaxDropDownHeight" Value="504" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="wpf:HighContrastState.IsTracked" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{TemplateBinding BorderBrush}"
                UseLayoutRounding="True">
          <Grid>
            <wpf:ClassicBorderDecorator Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{x:Static wpf:ClassicBorderDecorator.ClassicBorderBrush}"
                                        BorderThickness="2"
                                        BorderStyle="Sunken">
              <Popup Name="PART_Popup"
                     OverlayInputPassThroughElement="{Binding $parent[ComboBox]}"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                     IsLightDismissEnabled="True"
                     InheritsTransform="True"
                     WindowManagerAddShadowHint="False"
                     wpf:PopupAnimation.Kind="{DynamicResource SystemParameters.ComboBoxPopupAnimation}">
                <wpf:SystemDropShadowChrome Name="Shdw"
                                            MinWidth="{Binding Bounds.Width, ElementName=Border}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border Name="DropDownBorder"
                          Background="{DynamicResource SystemColors.WindowBrush}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemColors.WindowFrameBrush}">
                    <ScrollViewer Name="DropDownScrollViewer"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                  IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                                  IsScrollChainingEnabled="False">
                      <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                  </Border>
                </wpf:SystemDropShadowChrome>
              </Popup>
            </wpf:ClassicBorderDecorator>
            <DockPanel Margin="2">
              <!-- Saves space for the button, which is drawn on top. -->
              <Panel DockPanel.Dock="Right" Width="{DynamicResource SystemParameters.VerticalScrollBarWidth}" />
              <Border Name="SelectedItemBorder" Margin="{TemplateBinding Padding}">
                <Panel>
                  <TextBlock Name="PlaceholderTextBlock"
                             Margin="1"
                             HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                             Text="{TemplateBinding PlaceholderText}"
                             Foreground="{TemplateBinding PlaceholderForeground}"
                             IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
                  <ContentPresenter Name="ContentSite"
                                    Margin="1"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Panel>
              </Border>
            </DockPanel>
            <ToggleButton Name="DropDownButton"
                          Margin="2"
                          Theme="{StaticResource Classic.ComboBoxToggleButton}"
                          IsHitTestVisible="False"
                          IsEnabled="{TemplateBinding IsEnabled}"
                          IsChecked="{TemplateBinding IsDropDownOpen}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus:not(:dropdownopen)">
      <Style Selector="^ /template/ Border#SelectedItemBorder">
        <Setter Property="Background" Value="{DynamicResource SystemColors.HighlightBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#ContentSite">
        <Setter Property="Foreground" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
      </Style>
    </Style>
    <Style Selector="^:empty /template/ Border#DropDownBorder">
      <Setter Property="MinHeight" Value="95" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemColors.ControlBrush}" />
    </Style>
    <!-- WPF ComboBox, high contrast and disabled: a GrayText border. -->
    <Style Selector="^:highcontrast:disabled /template/ wpf|ClassicBorderDecorator#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>

    <!-- ComboBoxEditableTemplate. -->
    <Style Selector="^[IsEditable=True]">
      <Setter Property="Padding" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  UseLayoutRounding="True">
            <Grid>
              <wpf:ClassicBorderDecorator Name="Border"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{x:Static wpf:ClassicBorderDecorator.ClassicBorderBrush}"
                                          BorderThickness="2"
                                          BorderStyle="Sunken">
                <Popup Name="PART_Popup"
                       OverlayInputPassThroughElement="{Binding $parent[ComboBox]}"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                       IsLightDismissEnabled="True"
                       InheritsTransform="True"
                       WindowManagerAddShadowHint="False"
                       wpf:PopupAnimation.Kind="{DynamicResource SystemParameters.ComboBoxPopupAnimation}">
                  <wpf:SystemDropShadowChrome Name="Shdw"
                                              MinWidth="{Binding Bounds.Width, ElementName=Border}"
                                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <Border Name="DropDownBorder"
                            Background="{DynamicResource SystemColors.WindowBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemColors.WindowFrameBrush}">
                      <ScrollViewer Name="DropDownScrollViewer"
                                    HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                    VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                    IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                                    IsScrollChainingEnabled="False">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                      </ScrollViewer>
                    </Border>
                  </wpf:SystemDropShadowChrome>
                </Popup>
              </wpf:ClassicBorderDecorator>
              <ToggleButton Name="DropDownButton"
                            Margin="2"
                            Theme="{StaticResource Classic.ComboBoxToggleButton}"
                            IsHitTestVisible="False"
                            IsEnabled="{TemplateBinding IsEnabled}"
                            IsChecked="{TemplateBinding IsDropDownOpen}" />
              <DockPanel Margin="2">
                <!-- Saves space for the button, which is drawn on top. -->
                <Panel DockPanel.Dock="Right" Width="{DynamicResource SystemParameters.VerticalScrollBarWidth}" />
                <TextBox Name="PART_EditableTextBox"
                         Theme="{StaticResource Classic.ComboBoxEditableTextBox}"
                         Margin="{TemplateBinding Padding}"
                         Foreground="{TemplateBinding Foreground}"
                         Text="{TemplateBinding Text, Mode=TwoWay}"
                         PlaceholderText="{TemplateBinding PlaceholderText}"
                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </DockPanel>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- ToolBar.xaml ComboBoxStyleKey. -->
    <Style Selector="^.toolbar">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemColors.WindowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid UseLayoutRounding="True">
            <Grid Name="Inner" ColumnDefinitions="*,Auto">
              <Border Name="Background" Background="{TemplateBinding Background}" />
              <Border Name="SelectedContentBorder" Margin="2,2,1,2">
                <ContentPresenter Name="ContentSite"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center" />
              </Border>
              <Border Name="Border"
                      Grid.ColumnSpan="2"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      BorderBrush="{TemplateBinding BorderBrush}" />
              <ToggleButton Name="DropDownButton"
                            Grid.ColumnSpan="2"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Classic.ToolBar.ToolBar.ComboBoxStyleKey.DropDownButton.BorderBrush}"
                            Theme="{StaticResource Classic.ToolBarComboBoxToggleButton}"
                            IsHitTestVisible="False"
                            IsEnabled="{TemplateBinding IsEnabled}"
                            IsChecked="{TemplateBinding IsDropDownOpen}" />
              <TextBox Name="PART_EditableTextBox"
                       Theme="{StaticResource Classic.ComboBoxEditableTextBox}"
                       Padding="{TemplateBinding Padding}"
                       Margin="1,1,0,1"
                       MinHeight="18"
                       IsVisible="False"
                       Foreground="{TemplateBinding Foreground}"
                       Text="{TemplateBinding Text, Mode=TwoWay}"
                       VerticalAlignment="Center" />
            </Grid>
            <Popup Name="PART_Popup"
                   OverlayInputPassThroughElement="{Binding $parent[ComboBox]}"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True"
                   WindowManagerAddShadowHint="False"
                   wpf:PopupAnimation.Kind="{DynamicResource SystemParameters.ComboBoxPopupAnimation}">
              <wpf:SystemDropShadowChrome Name="Shdw"
                                          MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border Name="DropDownBorder"
                        Background="{TemplateBinding Background}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Classic.ToolBarMenuBorder}">
                  <ScrollViewer Name="DropDownScrollViewer"
                                HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                IsScrollChainingEnabled="False">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  </ScrollViewer>
                </Border>
              </wpf:SystemDropShadowChrome>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled">
        <Style Selector="^ /template/ Border#Background">
          <Setter Property="Background" Value="{DynamicResource Classic.ToolBarDisabledFill}" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style Selector="^ /template/ Border#Border">
          <Setter Property="BorderBrush" Value="{DynamicResource Classic.ToolBarDisabledBorder}" />
        </Style>
      </Style>
      <Style Selector="^:focus-within:not(:dropdownopen)">
        <Style Selector="^ /template/ Border#SelectedContentBorder">
          <Setter Property="Background" Value="{DynamicResource SystemColors.HighlightBrush}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#ContentSite">
          <Setter Property="Foreground" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
        </Style>
      </Style>
      <Style Selector="^[IsEditable=True]">
        <Setter Property="Padding" Value="2" />
        <Style Selector="^ /template/ Border#SelectedContentBorder">
          <Setter Property="Background" Value="{x:Null}" />
        </Style>
        <Style Selector="^ /template/ ToggleButton#DropDownButton">
          <Setter Property="Background" Value="{x:Null}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#ContentSite">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ TextBox#PART_EditableTextBox">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </Style>
      <Style Selector="^:pointerover, ^:focus-within">
        <Style Selector="^ /template/ ToggleButton#DropDownButton">
          <Setter Property="BorderBrush" Value="{DynamicResource Classic.ToolBarButtonHoverBorder}" />
          <Setter Property="Background" Value="{DynamicResource Classic.ToolBarButtonHover}" />
        </Style>
        <Style Selector="^ /template/ Border#Border">
          <Setter Property="BorderBrush" Value="{DynamicResource Classic.ToolBarButtonHoverBorder}" />
        </Style>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
