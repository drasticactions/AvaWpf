<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF Calendar.xaml CalendarDayButton [[Classic]]. VSM order is kept: Selected, then Inactive, then Today wins for
       the text color. -->
  <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton">
    <Setter Property="MinWidth" Value="5" />
    <Setter Property="MinHeight" Value="5" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClickMode" Value="Release" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Rectangle Name="TodayBackground" RadiusX="1" RadiusY="1" Opacity="0" Fill="{DynamicResource SystemColors.ActiveCaptionBrush}" />
          <Rectangle Name="SelectedBackground" RadiusX="1" RadiusY="1" Opacity="0" Fill="{DynamicResource SystemColors.HighlightBrush}" />
          <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" />
          <Rectangle Name="HighlightBackground" RadiusX="1" RadiusY="1" Opacity="0" Fill="{DynamicResource SystemColors.ControlLightLightBrush}">
            <Rectangle.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
              </Transitions>
            </Rectangle.Transitions>
          </Rectangle>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="5,1,5,1" />
          <Path Name="Blackout"
                Opacity="0"
                Margin="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Fill="{DynamicResource Classic.Calendar.CalendarDayButton.Blackout.Fill}"
                Stretch="Fill"
                Data="{DynamicResource Classic.Calendar.CalendarDayButton.Blackout.Data}" />
          <Rectangle Name="DayButtonFocusVisual"
                     IsVisible="False"
                     IsHitTestVisible="False"
                     RadiusX="1" RadiusY="1"
                     Stroke="{DynamicResource Classic.Calendar.CalendarDayButton.DayButtonFocusVisual.Stroke}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Classic.Invented.Calendar.Text}" />
    </Style>
    <Style Selector="^:pointerover /template/ Rectangle#HighlightBackground">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^:pressed /template/ Rectangle#HighlightBackground">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Rectangle#HighlightBackground">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.35" />
      </Style>
    </Style>
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Rectangle#SelectedBackground">
        <Setter Property="Opacity" Value="0.75" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
      </Style>
    </Style>
    <Style Selector="^:dayfocused /template/ Rectangle#DayButtonFocusVisual">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:inactive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Classic.Invented.Calendar.InactiveText}" />
    </Style>
    <Style Selector="^:today">
      <Style Selector="^ /template/ Rectangle#TodayBackground">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SystemColors.ActiveCaptionTextBrush}" />
      </Style>
    </Style>
    <Style Selector="^:blackout /template/ Path#Blackout">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
