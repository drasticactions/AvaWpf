<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- NotificationCard: the Windows 2000 tray balloon. It closes after a 100 ms delay so IsClosed is still raised. -->

  <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Width" Value="300" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.InfoTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SystemColors.InfoBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemColors.WindowFrameBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Template">
      <ControlTemplate>
        <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
          <Border Margin="5"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <DockPanel Margin="8,6">
              <Panel Name="PART_HeaderBar" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top" DockPanel.Dock="Left">
                <Path Name="IconShape" Data="{DynamicResource Classic.NotificationCard.CircleGeometry}" />
                <Path Name="IconGlyph" Data="{DynamicResource Classic.NotificationCard.InfoGlyph}" />
              </Panel>
              <ContentPresenter Name="PART_ContentPresenter" MinHeight="32" Content="{TemplateBinding Content}" />
            </DockPanel>
          </Border>
        </LayoutTransformControl>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Path#IconShape">
      <Setter Property="Fill" Value="{DynamicResource Classic.Invented.Notification.Information}" />
      <Setter Property="Stroke" Value="{DynamicResource Classic.Invented.Notification.IconOutline}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="^ /template/ Path#IconGlyph">
      <Setter Property="Fill" Value="{DynamicResource Classic.Invented.Notification.Glyph}" />
    </Style>
    <Style Selector="^:warning">
      <Style Selector="^ /template/ Path#IconShape">
        <Setter Property="Data" Value="{DynamicResource Classic.NotificationCard.TriangleGeometry}" />
        <Setter Property="Fill" Value="{DynamicResource Classic.Invented.Notification.Warning}" />
      </Style>
      <Style Selector="^ /template/ Path#IconGlyph">
        <Setter Property="Data" Value="{DynamicResource Classic.NotificationCard.WarningGlyph}" />
        <Setter Property="Fill" Value="{DynamicResource Classic.Invented.Notification.WarningGlyph}" />
      </Style>
    </Style>
    <Style Selector="^:error">
      <Style Selector="^ /template/ Path#IconShape">
        <Setter Property="Fill" Value="{DynamicResource Classic.Invented.Notification.Error}" />
      </Style>
      <Style Selector="^ /template/ Path#IconGlyph">
        <Setter Property="Data" Value="{DynamicResource Classic.NotificationCard.ErrorGlyph}" />
      </Style>
    </Style>
    <Style Selector="^[IsClosing=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.1" FillMode="Forward">
          <KeyFrame Cue="100%">
            <Setter Property="IsClosed" Value="True" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
