<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF Calendar.xaml CalendarItem [[Classic]]. Avalonia switches the month and year views from code (WPF uses
       DisplayMode triggers). -->
  <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">
    <Setter Property="Margin" Value="0,3,0,3" />
    <Setter Property="DayTitleTemplate">
      <Template x:DataType="x:String">
        <TextBlock FontWeight="Bold"
                   FontFamily="Verdana, DejaVu Sans, sans-serif"
                   FontSize="9.5"
                   Foreground="{DynamicResource Classic.Invented.Calendar.Text}"
                   HorizontalAlignment="Center"
                   Text="{Binding}"
                   Margin="0,6,0,6"
                   VerticalAlignment="Center" />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="PART_Root">
          <Border BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}">
            <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,Auto,Auto">
              <Button Name="PART_PreviousButton"
                      Grid.Row="0" Grid.Column="0"
                      Height="15" Width="20"
                      Padding="0"
                      Margin="8,0,0,0"
                      HorizontalAlignment="Left"
                      Focusable="False">
                <Path Height="10" Width="6"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Stretch="Fill"
                      Fill="{DynamicResource Classic.Invented.Calendar.Text}"
                      Data="{DynamicResource Classic.Calendar.CalendarItem.Path#1.Data}" />
              </Button>
              <Button Name="PART_HeaderButton"
                      Grid.Row="0" Grid.Column="1"
                      Theme="{StaticResource Classic.CalendarHeaderButton}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontWeight="Bold"
                      FontSize="10.5"
                      Focusable="False" />
              <Button Name="PART_NextButton"
                      Grid.Row="0" Grid.Column="2"
                      Height="15" Width="20"
                      Padding="0"
                      Margin="0,0,8,0"
                      HorizontalAlignment="Right"
                      Focusable="False">
                <Path Height="10" Width="6"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Stretch="Fill"
                      Fill="{DynamicResource Classic.Invented.Calendar.Text}"
                      Data="{DynamicResource Classic.Calendar.CalendarItem.Path#2.Data}" />
              </Button>
              <Grid Name="PART_MonthView"
                    Grid.Row="1" Grid.ColumnSpan="3"
                    IsVisible="False"
                    Margin="6,-1,6,6"
                    HorizontalAlignment="Center"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" />
              <Grid Name="PART_YearView"
                    Grid.Row="1" Grid.ColumnSpan="3"
                    IsVisible="False"
                    Margin="6,-3,7,6"
                    HorizontalAlignment="Center"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnDefinitions="Auto,Auto,Auto,Auto" />
            </Grid>
          </Border>
          <Rectangle Name="PART_DisabledVisual"
                     IsVisible="False"
                     Stretch="Fill"
                     StrokeThickness="1"
                     RadiusX="2" RadiusY="2"
                     Stroke="{DynamicResource Classic.DisabledColor}"
                     Fill="{DynamicResource Classic.DisabledColor}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:calendardisabled /template/ Rectangle#PART_DisabledVisual">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
