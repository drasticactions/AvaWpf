<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- TabbedPage: a Win98 property sheet built from WPF TabControl.xaml and TabItem.xaml [[Classic]]. -->

  <ControlTheme x:Key="{x:Type TabbedPage}" TargetType="TabbedPage">
    <Setter Property="Background" Value="{DynamicResource SystemColors.ControlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <TabControl Name="PART_TabControl"
                      Theme="{StaticResource Classic.TabbedPageTabControl}"
                      ItemContainerTheme="{StaticResource Classic.TabbedPageTabItem}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
