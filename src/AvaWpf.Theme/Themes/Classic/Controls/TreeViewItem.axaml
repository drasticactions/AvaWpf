<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF TreeViewItem.xaml with the [[Classic]] ExpandCollapseToggleStyle. No focus rectangle: WPF's
       TreeViewItemFocusVisual is an empty rectangle. -->
  <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="1,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,*">
          <ToggleButton Name="Expander"
                        Theme="{StaticResource Classic.TreeViewExpandCollapseToggle}"
                        MinWidth="19"
                        IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        ClickMode="Press" />
          <Border Name="Bd"
                  Grid.Column="1"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  UseLayoutRounding="True">
            <ContentPresenter Name="PART_Header"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center" />
          </Border>
          <ItemsPresenter Name="PART_ItemsPresenter"
                          Grid.Row="1"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          IsVisible="{TemplateBinding IsExpanded}"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:empty /template/ ToggleButton#Expander">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
      <Style Selector="^ /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SystemColors.HighlightBrush}" />
      </Style>
    </Style>
    <Style Selector="TreeView:not(:focus-within) ^:selected">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.InactiveSelectionHighlightTextBrush}" />
      <Style Selector="^ /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SystemColors.InactiveSelectionHighlightBrush}" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
