<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF MenuItem.xaml [[Classic]]: the implicit MenuItem style (SubmenuItem, or SubmenuHeader with sub-items).
       Top-level items get Classic.MenuItem.TopLevelHeader from Menu.ItemContainerTheme; the templates are in
       _MenuItemTemplates.axaml. -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem" BasedOn="{StaticResource Classic.MenuItem.SubmenuItem}">
    <Style Selector="^:not(:empty)">
      <Setter Property="Template" Value="{StaticResource Classic.MenuItem.SubmenuHeaderTemplate}" />
    </Style>
    <Style Selector="^:separator">
      <Setter Property="Template" Value="{StaticResource Classic.MenuItem.SeparatorTemplate}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
