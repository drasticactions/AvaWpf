<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf"
                    xmlns:luna="using:AvaWpf.Chrome.Luna">
  <!-- WPF Button.xaml BaseButtonStyle [[Luna.*]]: the Luna ButtonChrome; Button, ToggleButton and RepeatButton are
       BasedOn it. The schemes differ only in the face gradient and ThemeColor (Luna.ThemeColor). The .accent class
       keeps the defaulted ring on. -->
  <ControlTheme x:Key="Luna.BaseButtonStyle" TargetType="Button">
    <Setter Property="FocusAdorner" Value="{DynamicResource Luna.FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource Luna.ButtonNormalBackgroundFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Luna.ButtonBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <luna:ButtonChrome Name="Chrome"
                           ThemeColor="{DynamicResource Luna.ThemeColor}"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           Fill="{TemplateBinding Background}"
                           RenderDefaulted="{TemplateBinding wpf:ButtonState.IsDefaulted}"
                           RenderMouseOver="{TemplateBinding IsPointerOver}"
                           RenderPressed="{TemplateBinding IsPressed}"
                           UseLayoutRounding="True">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            RecognizesAccessKey="True" />
        </luna:ButtonChrome>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus /template/ luna|ButtonChrome#Chrome">
      <Setter Property="RenderDefaulted" Value="True" />
    </Style>
    <Style Selector="^.accent /template/ luna|ButtonChrome#Chrome">
      <Setter Property="RenderDefaulted" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ luna|ButtonChrome#Chrome">
      <Setter Property="RenderPressed" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
