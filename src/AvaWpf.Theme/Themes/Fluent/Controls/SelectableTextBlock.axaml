<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/TextBox.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!-- SelectableTextBlock as WPF's read-only TextBox without chrome, with a Copy context flyout. -->
  <MenuFlyout x:Key="Fluent.SelectableTextBlockContextFlyout" Placement="Bottom">
    <MenuItem Header="_Copy"
              Command="{Binding $parent[SelectableTextBlock].Copy}"
              IsEnabled="{Binding $parent[SelectableTextBlock].CanCopy}"
              InputGesture="{x:Static TextBox.CopyGesture}" />
  </MenuFlyout>
  <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{DynamicResource Fluent.TextControlSelectionHighlightColor}" />
    <Style Selector="^[IsEnabled=True]">
      <Setter Property="Cursor" Value="IBeam" />
      <Setter Property="ContextFlyout" Value="{StaticResource Fluent.SelectableTextBlockContextFlyout}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
