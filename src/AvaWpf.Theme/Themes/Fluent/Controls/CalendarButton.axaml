<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/Calendar.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!-- WPF DefaultCalendarButtonStyle (month, year and decade cells). -->
  <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MaxWidth" Value="70" />
    <Setter Property="MaxHeight" Value="70" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Name="SelectedBackground"
                     Background="{DynamicResource Fluent.CalendarViewSelectedBackground}"
                     Opacity="0"
                     CornerRadius="99" />
          <Border Name="Background"
                     Background="{DynamicResource Fluent.CalendarViewItemBackgroundPointerOver}"
                     Opacity="0"
                     CornerRadius="99">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter"
                            Margin="1,0,1,1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{DynamicResource Fluent.CalendarViewForeground}" />
          <Border Name="CalendarButtonFocusVisual"
                     IsHitTestVisible="False"
                     CornerRadius="99"
                     BorderBrush="{DynamicResource Fluent.CalendarViewForeground}"
                     BorderThickness="1"
                     IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- CommonStates -->
    <Style Selector="^:pointerover /template/ Border#Background">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Background">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- SelectionStates -->
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#SelectedBackground">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.CalendarViewTodayForeground}" />
      </Style>
    </Style>
    <!-- CalendarButtonFocusStates -->
    <Style Selector="^:btnfocused /template/ Border#CalendarButtonFocusVisual">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
