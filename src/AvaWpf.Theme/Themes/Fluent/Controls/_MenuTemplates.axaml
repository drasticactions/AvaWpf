<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf"
                    xmlns:conv="using:Avalonia.Controls.Converters">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/MenuItem.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    The four MenuItem role templates and role themes. Avalonia has no MenuItem.Role: the Menu applies the top-level
    theme through ItemContainerTheme and :empty picks header or item. WPF names CheckBoxBackground and
    CheckBoxBorderBrush for the check box, keys the Fluent dictionaries do not define, so the box is transparent.
  -->
  <conv:PlatformKeyGestureConverter x:Key="Fluent.MenuItem.KeyGestureConverter" />

  <!-- TopLevelHeader -->
  <ControlTemplate x:Key="Fluent.MenuItem.TopLevelHeaderTemplateKey" TargetType="MenuItem">
    <Border Name="Border"
            Margin="4"
            BorderThickness="{TemplateBinding BorderThickness}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            CornerRadius="6">
      <Grid RowDefinitions="*,Auto">
        <Grid Margin="10" ColumnDefinitions="Auto,*">
          <ContentPresenter Name="Icon"
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            IsVisible="False"
                            Content="{TemplateBinding Icon}" />
          <ContentPresenter Name="PART_HeaderPresenter"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            RecognizesAccessKey="True"
                            Margin="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <Popup Name="PART_Popup"
               Grid.Row="1"
               WindowManagerAddShadowHint="False"
               HorizontalOffset="-12"
               VerticalOffset="1"
               IsLightDismissEnabled="True"
               IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
               Placement="BottomEdgeAlignedLeft"
               PlacementTarget="Border"
               OverlayInputPassThroughElement="{Binding $parent[Menu]}">
          <Grid>
            <Border Name="SubmenuBorder"
                    Margin="12,0,12,18"
                    Padding="0,3,0,3"
                    Background="{DynamicResource Fluent.FlyoutBackground}"
                    BorderBrush="{DynamicResource Fluent.FlyoutBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    UseLayoutRounding="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="20" OffsetX="0" OffsetY="6" Opacity="0.25" />
              </Border.Effect>
              <ScrollViewer Theme="{StaticResource Fluent.MenuScrollViewer}">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                KeyboardNavigation.TabNavigation="Cycle"
                                Grid.IsSharedSizeScope="True" />
              </ScrollViewer>
            </Border>
          </Grid>
        </Popup>
      </Grid>
    </Border>
  </ControlTemplate>

  <!-- TopLevelItem -->
  <ControlTemplate x:Key="Fluent.MenuItem.TopLevelItemTemplateKey" TargetType="MenuItem">
    <Border Name="Border"
            Margin="4"
            BorderThickness="{TemplateBinding BorderThickness}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            CornerRadius="6">
      <Grid Margin="10" ColumnDefinitions="Auto,*">
        <ContentPresenter Name="Icon"
                          Grid.Column="0"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          IsVisible="False"
                          Content="{TemplateBinding Icon}" />
        <ContentPresenter Name="PART_HeaderPresenter"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          Margin="{TemplateBinding Padding}"
                          RecognizesAccessKey="True"
                          Foreground="{TemplateBinding Foreground}" />
      </Grid>
    </Border>
  </ControlTemplate>

  <!-- SubmenuItem -->
  <ControlTemplate x:Key="Fluent.MenuItem.SubmenuItemTemplateKey" TargetType="MenuItem">
    <Border Name="Border"
            Margin="4,1,4,1"
            BorderThickness="{TemplateBinding BorderThickness}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            CornerRadius="4">
      <Grid Margin="8,6,8,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemCheckBoxIconColumnGroup" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
        </Grid.ColumnDefinitions>
        <Border Name="CheckBoxIconBorder"
                Grid.Column="0"
                Width="20"
                Height="20"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="4"
                IsVisible="False">
          <TextBlock Name="CheckBoxIcon"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontFamily="{DynamicResource Fluent.SymbolThemeFontFamily}"
                     FontSize="16"
                     Text=""
                     TextAlignment="Center" />
        </Border>
        <ContentPresenter Name="Icon"
                          Grid.Column="1"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          IsVisible="False"
                          Content="{TemplateBinding Icon}" />
        <ContentPresenter Name="PART_HeaderPresenter"
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          RecognizesAccessKey="True"
                          Margin="{TemplateBinding Padding}"
                          Foreground="{TemplateBinding Foreground}" />
        <TextBlock Name="InputGestureText"
                   Grid.Column="3"
                   Margin="25,0,0,0"
                   VerticalAlignment="Bottom"
                   FontSize="11"
                   Foreground="{DynamicResource Fluent.TextFillColorDisabledBrush}"
                   Text="{TemplateBinding InputGesture, Converter={StaticResource Fluent.MenuItem.KeyGestureConverter}}"
                   IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Border>
  </ControlTemplate>

  <!-- SubItem with Subitems -->
  <ControlTemplate x:Key="Fluent.MenuItem.SubmenuHeaderTemplateKey" TargetType="MenuItem">
    <Grid RowDefinitions="*,Auto">
      <Border Name="Border"
              Grid.Row="1"
              Margin="4,1,4,1"
              BorderThickness="{TemplateBinding BorderThickness}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              CornerRadius="4">
        <Grid Name="MenuItemContent" Margin="8,6,8,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentPresenter Name="Icon"
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            IsVisible="False"
                            Content="{TemplateBinding Icon}" />
          <ContentPresenter Name="PART_HeaderPresenter"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            RecognizesAccessKey="True" />
          <Grid Grid.Column="2">
            <TextBlock Name="Chevron"
                       Margin="0,3,0,0"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource Fluent.SymbolThemeFontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Text="{x:Static wpf:FluentGlyph.ChevronRight}" />
          </Grid>
        </Grid>
      </Border>
      <Popup Name="PART_Popup"
             Grid.Row="1"
             WindowManagerAddShadowHint="False"
             IsLightDismissEnabled="False"
             IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
             Placement="RightEdgeAlignedTop"
             PlacementTarget="MenuItemContent"
             VerticalOffset="-20">
        <Grid>
          <Border Name="SubmenuBorder"
                  Margin="12,10,12,18"
                  Padding="0,3,0,3"
                  Background="{DynamicResource Fluent.FlyoutBackground}"
                  BorderBrush="{DynamicResource Fluent.FlyoutBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  UseLayoutRounding="True">
            <Border.Effect>
              <DropShadowEffect BlurRadius="20" OffsetX="0" OffsetY="6" Opacity="0.5" />
            </Border.Effect>
            <ScrollViewer Theme="{StaticResource Fluent.MenuScrollViewer}">
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              KeyboardNavigation.TabNavigation="Cycle"
                              Grid.IsSharedSizeScope="True" />
            </ScrollViewer>
          </Border>
        </Grid>
      </Popup>
    </Grid>
  </ControlTemplate>

  <!-- MenuItem.SeparatorStyleKey: a "-" item draws a 1 px MenuBarItemBorderBrush line with margin 0,1. -->
  <ControlTemplate x:Key="Fluent.MenuItem.SeparatorTemplate" TargetType="MenuItem">
    <Separator Margin="0,1,0,1" BorderBrush="{DynamicResource Fluent.MenuBarItemBorderBrush}" />
  </ControlTemplate>

  <!-- The role themes (DefaultMenuItemStyle setters and each role template's triggers, in WPF order). -->
  <ControlTheme x:Key="Fluent.MenuItem.TopLevelItem" TargetType="MenuItem">
    <Setter Property="FocusAdorner" Value="{DynamicResource Fluent.CollectionFocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template" Value="{StaticResource Fluent.MenuItem.TopLevelItemTemplateKey}" />
    <Style Selector="^:selected /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource Fluent.MenuBarItemBackgroundSelected}" />
    </Style>
    <Style Selector="^:icon /template/ ContentPresenter#Icon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Fluent.MenuItem.MenuItem.TopLevelItemTemplateKey.Self.Foreground.IsEnabled_False}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Fluent.MenuItem.TopLevelHeader" TargetType="MenuItem" BasedOn="{StaticResource Fluent.MenuItem.TopLevelItem}">
    <Setter Property="Template" Value="{StaticResource Fluent.MenuItem.TopLevelHeaderTemplateKey}" />
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Fluent.MenuItem.MenuItem.TopLevelHeaderTemplateKey.Self.Foreground.IsEnabled_False}" />
    </Style>
    <Style Selector="^:open /template/ Border#SubmenuBorder">
      <Style.Animations>
        <Animation Duration="{x:Static wpf:FluentTimings.Fast}" Easing="CircularEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.Y" Value="-90" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- A top-level item without children uses TopLevelItemTemplateKey. -->
    <Style Selector="^:empty">
      <Setter Property="Template" Value="{StaticResource Fluent.MenuItem.TopLevelItemTemplateKey}" />
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.MenuItem.MenuItem.TopLevelItemTemplateKey.Self.Foreground.IsEnabled_False}" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Fluent.MenuItem.SubmenuItem" TargetType="MenuItem">
    <Setter Property="FocusAdorner" Value="{DynamicResource Fluent.CollectionFocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template" Value="{StaticResource Fluent.MenuItem.SubmenuItemTemplateKey}" />
    <Style Selector="^:selected /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource Fluent.MenuBarItemBackgroundSelected}" />
    </Style>
    <Style Selector="^:icon /template/ ContentPresenter#Icon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:toggle /template/ Border#CheckBoxIconBorder, ^:radio /template/ Border#CheckBoxIconBorder">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ TextBlock#CheckBoxIcon">
      <Setter Property="Text" Value="{x:Static wpf:FluentGlyph.CheckMark}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Fluent.MenuItem.MenuItem.SubmenuItemTemplateKey.Self.Foreground.IsEnabled_False}" />
    </Style>
    <Style Selector="^:separator">
      <Setter Property="Template" Value="{StaticResource Fluent.MenuItem.SeparatorTemplate}" />
      <Setter Property="Focusable" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Fluent.MenuItem.SubmenuHeader" TargetType="MenuItem">
    <Setter Property="FocusAdorner" Value="{DynamicResource Fluent.CollectionFocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template" Value="{StaticResource Fluent.MenuItem.SubmenuHeaderTemplateKey}" />
    <Style Selector="^:icon /template/ ContentPresenter#Icon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:selected /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource Fluent.MenuBarItemBackgroundSelected}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Fluent.MenuItem.MenuItem.SubmenuHeaderTemplateKey.Self.Foreground.IsEnabled_false}" />
      <Style Selector="^ /template/ TextBlock#Chevron">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.MenuItem.MenuItem.SubmenuHeaderTemplateKey.Chevron.Foreground.IsEnabled_false}" />
      </Style>
    </Style>
    <Style Selector="^:open /template/ Border#SubmenuBorder">
      <Style.Animations>
        <Animation Duration="{x:Static wpf:FluentTimings.Fast}" Easing="CircularEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.Y" Value="-90" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
