<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/ScrollBar.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    WPF DefaultScrollBarStyle. The IsMouseOver Enter/Exit storyboards (160 ms) are DoubleTransitions on the track size
    and opacities.
  -->
  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource Fluent.ScrollBarTrackFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ScrollBarTrackStroke}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />

    <Style Selector="^:vertical">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Name="PART_Border"
                    Grid.RowSpan="3"
                    Width="12"
                    HorizontalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="6"
                    Opacity="0">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <RepeatButton Name="PART_LineUpButton"
                          Grid.Row="0"
                          Classes="up"
                          MaxHeight="14"
                          HorizontalContentAlignment="Left"
                          Opacity="0"
                          AutomationProperties.Name="Scroll Up"
                          Theme="{StaticResource Fluent.ScrollBarLineButton}">
              <RepeatButton.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
              </RepeatButton.Transitions>
            </RepeatButton>
            <Track Name="PART_Track"
                   Grid.Row="1"
                   Width="4"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True">
              <Track.Transitions>
                <Transitions>
                  <DoubleTransition Property="Width" Duration="0:0:0.16" />
                </Transitions>
              </Track.Transitions>
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource Fluent.ScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource Fluent.ScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb Margin="0" Padding="0" Classes="vertical" Theme="{StaticResource Fluent.ScrollBarThumb}" />
            </Track>
            <RepeatButton Name="PART_LineDownButton"
                          Grid.Row="2"
                          Classes="down"
                          MaxHeight="14"
                          HorizontalContentAlignment="Left"
                          Opacity="0"
                          AutomationProperties.Name="Scroll Down"
                          Theme="{StaticResource Fluent.ScrollBarLineButton}">
              <RepeatButton.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
              </RepeatButton.Transitions>
            </RepeatButton>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Track#PART_Track">
        <Setter Property="Width" Value="8" />
      </Style>
    </Style>

    <Style Selector="^:horizontal">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Name="PART_Border"
                    Grid.ColumnSpan="3"
                    Height="12"
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="6"
                    Opacity="0">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <RepeatButton Name="PART_LineUpButton"
                          Grid.Column="0"
                          Classes="left"
                          MaxWidth="18"
                          VerticalAlignment="Center"
                          Opacity="0"
                          AutomationProperties.Name="Scroll Left"
                          Theme="{StaticResource Fluent.ScrollBarLineButton}">
              <RepeatButton.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
              </RepeatButton.Transitions>
            </RepeatButton>
            <Track Name="PART_Track"
                   Grid.Column="1"
                   Height="4"
                   VerticalAlignment="Center"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="False">
              <Track.Transitions>
                <Transitions>
                  <DoubleTransition Property="Height" Duration="0:0:0.16" />
                </Transitions>
              </Track.Transitions>
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource Fluent.ScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource Fluent.ScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb Margin="0" Padding="0" Classes="horizontal" Theme="{StaticResource Fluent.ScrollBarThumb}" />
            </Track>
            <RepeatButton Name="PART_LineDownButton"
                          Grid.Column="2"
                          Classes="right"
                          MaxWidth="18"
                          VerticalAlignment="Center"
                          Opacity="0"
                          AutomationProperties.Name="Scroll Right"
                          Theme="{StaticResource Fluent.ScrollBarLineButton}">
              <RepeatButton.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
              </RepeatButton.Transitions>
            </RepeatButton>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Track#PART_Track">
        <Setter Property="Height" Value="8" />
      </Style>
    </Style>

    <!-- IsMouseOver: the track fill, the buttons and the wider track. -->
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Fluent.ScrollBarTrackFillPointerOver}" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_LineUpButton">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_LineDownButton">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
