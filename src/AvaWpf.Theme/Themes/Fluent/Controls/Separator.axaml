<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/Separator.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    WPF DefaultSeparatorStyle. WPF also binds Margin to the Border, which would apply it twice in Avalonia, so it is applied once.
    Classes: toolbar (ToolBar.SeparatorStyleKey), statusbar (StatusBar.SeparatorStyleKey); :menu is MenuItem.SeparatorStyleKey.
  -->
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="BorderBrush" Value="{DynamicResource Fluent.SeparatorBorderBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Width="{TemplateBinding Width}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                UseLayoutRounding="True" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:menu">
      <Setter Property="BorderBrush" Value="{DynamicResource Fluent.MenuBarItemBorderBrush}" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="^.statusbar">
      <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ControlElevationBorderBrush}" />
      <Setter Property="Margin" Value="6,0" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
