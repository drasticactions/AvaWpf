<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/ProgressBar.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    WPF ProgressBar. Indeterminate: WPF scales a full-width rectangle by 0.25 and moves its RenderTransformOrigin from
    -0.5 to 1.5; here the rectangle is 25 % wide and translated by the same distances (AnimationFactorToValueConverter).
    Vertical: WPF rotates with a LayoutTransform; Avalonia's ProgressBar sizes PART_Indicator by height natively.
  -->
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar" x:DataType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Fluent.ProgressBarForeground}" />
    <Setter Property="Background" Value="{DynamicResource Fluent.ProgressBarBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ProgressBarBorderBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="TemplateRoot" ClipToBounds="True">
          <Border Name="TrackBorder"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Background="{TemplateBinding Background}"
                  Margin="1" />
          <Border Name="PART_Indicator"
                  Margin="1"
                  Background="{TemplateBinding BorderBrush}"
                  HorizontalAlignment="Left">
            <Panel>
              <Rectangle Name="Indicator"
                         Fill="{TemplateBinding Foreground}"
                         RadiusX="6" RadiusY="6" />
              <Rectangle Name="Animation"
                         IsVisible="False"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Stretch"
                         Fill="{TemplateBinding Foreground}"
                         RadiusX="6" RadiusY="6">
                <Rectangle.RenderTransform>
                  <TranslateTransform />
                </Rectangle.RenderTransform>
              </Rectangle>
            </Panel>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="4" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="4" />
      <Setter Property="MinHeight" Value="0" />
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
      </Style>
    </Style>

    <!-- IsIndeterminate -->
    <Style Selector="^:indeterminate">
      <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ProgressBarIndeterminateBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource Fluent.ProgressBarIndeterminateBackground}" />
      <Style Selector="^ /template/ Rectangle#Indicator">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Rectangle#Animation">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>

    <Style Selector="^:indeterminate:horizontal">
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^ /template/ Rectangle#Animation">
        <Setter Property="Width">
          <MultiBinding Converter="{x:Static wpf:AnimationFactorToValueConverter.Instance}">
            <Binding Path="Bounds.Width" RelativeSource="{RelativeSource TemplatedParent}" />
            <Binding><Binding.Source><x:Double>0.25</x:Double></Binding.Source></Binding>
          </MultiBinding>
        </Setter>
        <Style.Animations>
          <Animation Duration="0:0:0.9" IterationCount="Infinite">
            <KeyFrame Cue="0%">
              <Setter Property="TranslateTransform.X">
                <MultiBinding Converter="{x:Static wpf:AnimationFactorToValueConverter.Instance}">
                  <Binding Path="((Visual)Parent).Bounds.Width" RelativeSource="{RelativeSource Self}" />
                  <Binding><Binding.Source><x:Double>-0.375</x:Double></Binding.Source></Binding>
                </MultiBinding>
              </Setter>
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="TranslateTransform.X">
                <MultiBinding Converter="{x:Static wpf:AnimationFactorToValueConverter.Instance}">
                  <Binding Path="((Visual)Parent).Bounds.Width" RelativeSource="{RelativeSource Self}" />
                  <Binding><Binding.Source><x:Double>1.125</x:Double></Binding.Source></Binding>
                </MultiBinding>
              </Setter>
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </Style>

    <Style Selector="^:indeterminate:vertical">
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^ /template/ Rectangle#Animation">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Height">
          <MultiBinding Converter="{x:Static wpf:AnimationFactorToValueConverter.Instance}">
            <Binding Path="((Visual)Parent).Bounds.Height" RelativeSource="{RelativeSource Self}" />
            <Binding><Binding.Source><x:Double>0.25</x:Double></Binding.Source></Binding>
          </MultiBinding>
        </Setter>
        <Style.Animations>
          <Animation Duration="0:0:0.9" IterationCount="Infinite">
            <KeyFrame Cue="0%">
              <Setter Property="TranslateTransform.Y">
                <MultiBinding Converter="{x:Static wpf:AnimationFactorToValueConverter.Instance}" ConverterParameter="negative">
                  <Binding Path="((Visual)Parent).Bounds.Height" RelativeSource="{RelativeSource Self}" />
                  <Binding><Binding.Source><x:Double>-0.375</x:Double></Binding.Source></Binding>
                </MultiBinding>
              </Setter>
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="TranslateTransform.Y">
                <MultiBinding Converter="{x:Static wpf:AnimationFactorToValueConverter.Instance}" ConverterParameter="negative">
                  <Binding Path="((Visual)Parent).Bounds.Height" RelativeSource="{RelativeSource Self}" />
                  <Binding><Binding.Source><x:Double>1.125</x:Double></Binding.Source></Binding>
                </MultiBinding>
              </Setter>
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
