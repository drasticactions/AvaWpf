<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/ContextMenu.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    Fluent.PopupPanel: the ContextMenu frame for popup content. WPF Fluent menus draw no shadow; neither does this
    panel.
  -->
  <ControlTheme x:Key="Fluent.PopupPanel" TargetType="ContentControl">
    <Setter Property="Foreground" Value="{DynamicResource Fluent.ContextMenuForeground}" />
    <Setter Property="Background" Value="{DynamicResource Fluent.ContextMenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ContextMenuBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Fluent.ContextMenuBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Fluent.OverlayCornerRadius}" />
    <Setter Property="Padding" Value="0,3,0,3" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Border"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                UseLayoutRounding="True">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
