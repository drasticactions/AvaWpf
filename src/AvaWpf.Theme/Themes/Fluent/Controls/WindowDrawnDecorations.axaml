<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!--
    Avalonia's drawn window decorations in the Fluent WindowFrame look. Parts and layout follow Avalonia's Fluent theme
    (see NOTICE.md).
  -->
  <ControlTheme x:Key="Fluent.DrawnCaptionButton" TargetType="Button" BasedOn="{StaticResource Fluent.CaptionButton}">
    <Setter Property="Height" Value="{DynamicResource Fluent.Invented.WindowFrame.CaptionHeight}" />
    <Setter Property="(WindowDecorationProperties.ElementRole)" Value="DecorationsElement" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="32" />
    <Setter Property="DefaultFrameThickness" Value="1" />
    <Setter Property="DefaultShadowThickness" Value="16" />
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>
          <WindowDrawnDecorationsContent.Underlay>
            <Panel Name="PART_UnderlayWrapper">
              <Border Name="PART_WindowBorder"
                      Background="Transparent"
                      BorderThickness="{TemplateBinding FrameThickness}"
                      BorderBrush="{DynamicResource Fluent.SurfaceStrokeColorDefaultBrush}"
                      CornerRadius="{DynamicResource Fluent.OverlayCornerRadius}"
                      IsHitTestVisible="False" />
              <Panel Name="PART_TitleBar" VerticalAlignment="Top"
                     Height="{TemplateBinding TitleBarHeight}"
                     Background="{DynamicResource Fluent.SolidBackgroundFillColorBaseBrush}"
                     IsVisible="{TemplateBinding HasTitleBar}"
                     WindowDecorationProperties.ElementRole="TitleBar" />
            </Panel>
          </WindowDrawnDecorationsContent.Underlay>
          <WindowDrawnDecorationsContent.Overlay>
            <Panel Name="PART_OverlayWrapper">
              <Panel Name="PART_TitleTextPanel" VerticalAlignment="Top"
                     Height="{TemplateBinding TitleBarHeight}"
                     IsHitTestVisible="False"
                     IsVisible="{TemplateBinding HasTitleBar}">
                <TextBlock Text="{TemplateBinding Title}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           FontFamily="{DynamicResource SystemFonts.CaptionFontFamily}"
                           FontSize="12"
                           Foreground="{DynamicResource Fluent.TextFillColorPrimaryBrush}" />
              </Panel>
              <StackPanel Name="PART_OverlayPanel"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          Height="{TemplateBinding TitleBarHeight}"
                          IsVisible="{TemplateBinding HasTitleBar}"
                          Orientation="Horizontal">
                <Button Name="PART_FullScreenButton"
                        Theme="{StaticResource Fluent.DrawnCaptionButton}"
                        Content="{x:Static wpf:FluentGlyph.ChromeMaximize}"
                        WindowDecorationProperties.ElementRole="FullScreenButton" />
                <Button Name="PART_MinimizeButton"
                        Theme="{StaticResource Fluent.DrawnCaptionButton}"
                        Content="{x:Static wpf:FluentGlyph.ChromeMinimize}"
                        WindowDecorationProperties.ElementRole="MinimizeButton" />
                <Button Name="PART_MaximizeButton"
                        Theme="{StaticResource Fluent.DrawnCaptionButton}"
                        Content="{x:Static wpf:FluentGlyph.ChromeMaximize}"
                        WindowDecorationProperties.ElementRole="MaximizeButton" />
                <Button Name="PART_CloseButton"
                        Classes="close"
                        CornerRadius="0,7,0,0"
                        Theme="{StaticResource Fluent.DrawnCaptionButton}"
                        Content="{x:Static wpf:FluentGlyph.ChromeClose}"
                        WindowDecorationProperties.ElementRole="CloseButton" />
              </StackPanel>
            </Panel>
          </WindowDrawnDecorationsContent.Overlay>
          <WindowDrawnDecorationsContent.FullscreenPopover>
            <Panel Height="{TemplateBinding DefaultTitleBarHeight}"
                   VerticalAlignment="Top"
                   Background="{DynamicResource Fluent.SolidBackgroundFillColorBaseBrush}"
                   WindowDecorationProperties.ElementRole="DecorationsElement">
              <TextBlock Text="{TemplateBinding Title}"
                         VerticalAlignment="Center"
                         Margin="16,0,0,0"
                         FontFamily="{DynamicResource SystemFonts.CaptionFontFamily}"
                         FontSize="12"
                         Foreground="{DynamicResource Fluent.TextFillColorPrimaryBrush}" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Name="PART_PopoverFullScreenButton"
                        Theme="{StaticResource Fluent.DrawnCaptionButton}"
                        Content="{x:Static wpf:FluentGlyph.ChromeRestore}"
                        WindowDecorationProperties.ElementRole="FullScreenButton" />
                <Button Name="PART_PopoverCloseButton"
                        Classes="close"
                        Theme="{StaticResource Fluent.DrawnCaptionButton}"
                        Content="{x:Static wpf:FluentGlyph.ChromeClose}"
                        WindowDecorationProperties.ElementRole="CloseButton" />
              </StackPanel>
            </Panel>
          </WindowDrawnDecorationsContent.FullscreenPopover>
        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>
    <Style Selector="^:has-shadow /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-shadow /template/ Border#PART_WindowBorder">
      <Setter Property="BoxShadow" Value="{DynamicResource Fluent.Invented.WindowFrame.Shadow}" />
    </Style>
    <Style Selector="^:has-shadow /template/ Panel#PART_OverlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-border /template/ Panel#PART_TitleTextPanel">
      <Setter Property="Margin" Value="1,1,1,0" />
    </Style>
    <Style Selector="^:has-border /template/ Panel#PART_TitleBar">
      <Setter Property="Margin" Value="1,1,1,0" />
    </Style>
    <Style Selector="^:has-border /template/ StackPanel#PART_OverlayPanel">
      <Setter Property="Margin" Value="0,1,1,0" />
    </Style>
    <Style Selector="^:maximized /template/ Button#PART_MaximizeButton">
      <Setter Property="Content" Value="{x:Static wpf:FluentGlyph.ChromeRestore}" />
    </Style>
    <Style Selector="^:maximized /template/ Border#PART_WindowBorder">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^:maximized /template/ Button#PART_CloseButton">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^ /template/ Button:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-fullscreen) /template/ Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-fullscreen) /template/ Button#PART_PopoverFullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ Panel#PART_TitleTextPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ StackPanel#PART_OverlayPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ Panel#PART_TitleBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
