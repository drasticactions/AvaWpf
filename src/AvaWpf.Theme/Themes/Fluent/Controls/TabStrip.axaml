<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/TabControl.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!-- TabStrip: the header panel of WPF DefaultTopTabControlStyle on its own. -->
  <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">
    <Setter Property="Foreground" Value="{DynamicResource Fluent.TabViewForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fluent.TabViewBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel />
      </ItemsPanelTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
