<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/GridSplitter.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    WPF DefaultGridSplitterStyle. Dragging is :pressed. WPF turns the grip for rows by Cursor=SizeNS; here by
    ResizeDirection=Rows, or Auto with a non-Stretch vertical alignment (how GridSplitter resolves Auto to rows).
  -->
  <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusAdorner" Value="{DynamicResource Fluent.FocusVisual}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="{DynamicResource Fluent.GridsplitterMinHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource Fluent.GridsplitterMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Fluent.GridsplitterPadding}" />
    <Setter Property="Foreground" Value="{DynamicResource Fluent.GridsplitterForeground}" />
    <Setter Property="Background" Value="{DynamicResource Fluent.GridsplitterBackground}" />
    <Setter Property="PreviewContent">
      <Template>
        <Rectangle Fill="{DynamicResource Fluent.AccentFillColorDefaultBrush}" />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="RootGrid"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}">
          <Rectangle Name="PART_Thumb"
                     Width="{DynamicResource Fluent.GridsplitterThumbWidth}"
                     Height="{DynamicResource Fluent.GridsplitterThumbHeight}"
                     Margin="{TemplateBinding Padding}"
                     Fill="{TemplateBinding Foreground}"
                     RadiusX="{DynamicResource Fluent.GridsplitterThumbRadius}"
                     RadiusY="{DynamicResource Fluent.GridsplitterThumbRadius}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource Fluent.GridsplitterBackgroundPointerOver}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource Fluent.GridsplitterBackgroundPressed}" />
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource Fluent.GridsplitterBackgroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_Thumb">
        <Setter Property="Opacity" Value="0.45" />
      </Style>
    </Style>
    <Style Selector="^[ResizeDirection=Rows] /template/ Rectangle#PART_Thumb, ^[ResizeDirection=Auto][HorizontalAlignment=Stretch]:not(^[VerticalAlignment=Stretch]) /template/ Rectangle#PART_Thumb">
      <Setter Property="Width" Value="{DynamicResource Fluent.GridsplitterThumbHeight}" />
      <Setter Property="Height" Value="{DynamicResource Fluent.GridsplitterThumbWidth}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
