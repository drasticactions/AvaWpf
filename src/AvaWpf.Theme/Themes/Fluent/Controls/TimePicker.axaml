<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The flyout TimePicker in the Windows 11 manner. Column texts default to "hour", "minute" and "second", as Windows
    shows them.
  -->
  <ControlTheme x:Key="{x:Type TimePicker}" TargetType="TimePicker">
    <Setter Property="FocusAdorner" Value="{DynamicResource Fluent.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Fluent.TimePickerButtonForegroundDefault}" />
    <Setter Property="Background" Value="{DynamicResource Fluent.TimePickerButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ControlElevationBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Fluent.ControlCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="242" />
    <Setter Property="MaxWidth" Value="456" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid Name="LayoutRoot" Margin="{TemplateBinding Padding}">
            <Button Name="PART_FlyoutButton"
                    Theme="{StaticResource Fluent.DateTimePickerFlyoutButton}"
                    Foreground="{TemplateBinding Foreground}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MaxWidth="{TemplateBinding MaxWidth}"
                    MinHeight="{TemplateBinding MinHeight}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <Grid Name="PART_FlyoutButtonContentGrid">
                <!-- Column definitions are set in code. -->
                <Border Name="PART_FirstPickerHost" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <TextBlock Name="PART_HourTextBlock" Text="hour" HorizontalAlignment="Center"
                             Padding="{DynamicResource Fluent.TimePickerHostPadding}" />
                </Border>
                <Rectangle Name="PART_FirstColumnDivider"
                           Fill="{DynamicResource Fluent.DividerStrokeColorDefaultBrush}"
                           HorizontalAlignment="Center" Width="1" Grid.Column="1" />
                <Border Name="PART_SecondPickerHost" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <TextBlock Name="PART_MinuteTextBlock" Text="minute" HorizontalAlignment="Center"
                             Padding="{DynamicResource Fluent.TimePickerHostPadding}" />
                </Border>
                <Rectangle Name="PART_SecondColumnDivider"
                           Fill="{DynamicResource Fluent.DividerStrokeColorDefaultBrush}"
                           HorizontalAlignment="Center" Width="1" Grid.Column="3" />
                <Border Name="PART_ThirdPickerHost" Grid.Column="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <TextBlock Name="PART_SecondTextBlock" Text="second" HorizontalAlignment="Center"
                             Padding="{DynamicResource Fluent.TimePickerHostPadding}" />
                </Border>
                <Rectangle Name="PART_ThirdColumnDivider"
                           Fill="{DynamicResource Fluent.DividerStrokeColorDefaultBrush}"
                           HorizontalAlignment="Center" Width="1" Grid.Column="5" />
                <Border Name="PART_FourthPickerHost" Grid.Column="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <TextBlock Name="PART_PeriodTextBlock" HorizontalAlignment="Center"
                             Padding="{DynamicResource Fluent.TimePickerHostPadding}" />
                </Border>
              </Grid>
            </Button>
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsLightDismissEnabled="True"
                   PlacementTarget="{TemplateBinding}"
                   Placement="Bottom">
              <TimePickerPresenter Name="PART_PickerPresenter" />
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled /template/ Rectangle">
      <Setter Property="Fill" Value="{DynamicResource Fluent.ControlStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="VerticalAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
    </Style>
    <Style Selector="^:hasnotime /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fluent.TextControlPlaceholderForeground}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
