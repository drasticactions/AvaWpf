<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/ListBoxItem.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    WPF DefaultListBoxItemStyle. WPF binds the content alignment to the owning ItemsControl's; Avalonia's ItemsControl
    has none, so the items use the ListBox's VerticalContentAlignment Center and stretch across.
  -->
  <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Fluent.ListBoxItemForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{DynamicResource Fluent.CollectionFocusVisual}" />
    <Setter Property="Margin" Value="{DynamicResource Fluent.ListBoxItemMargin}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource Fluent.ListBoxItemPadding}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Border"
                Margin="0"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{TemplateBinding BorderBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                UseLayoutRounding="True">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource Fluent.ListBoxItemSelectedForegroundThemeBrush}" />
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource Fluent.ListBoxItemSelectedBackgroundThemeBrush}" />
      </Style>
    </Style>
    <Style Selector="^:not(:selected):pointerover /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource Fluent.ListBoxItemUnselectedBackgroundPointerOverThemeBrush}" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource Fluent.ListBoxItemSelectedBackgroundPointerOverThemeBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
