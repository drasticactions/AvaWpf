<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/ComboBox.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    WPF DefaultComboBoxStyle with DefaultComboBoxTemplate / EditableComboBoxTemplate. Class toolbar: ToolBar.ComboBoxStyleKey.
    Avalonia opens the non-editable drop-down from the ComboBox itself, so the toggle button is only in the editable template.
  -->
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="FocusAdorner" Value="{DynamicResource Fluent.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxForeground}" />
    <Setter Property="Background" Value="{DynamicResource Fluent.ComboBoxBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ComboBoxBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Fluent.ComboBoxBorderThemeThickness}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="{DynamicResource Fluent.TextControlThemeMinHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource Fluent.TextControlThemeMinWidth}" />
    <Setter Property="Padding" Value="{DynamicResource Fluent.ComboBoxPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Fluent.ControlCornerRadius}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Fluent.TextControlPlaceholderForeground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid Name="LayoutGrid" ColumnDefinitions="*,38">
            <Border Name="ContentBorder"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    UseLayoutRounding="True" />

            <TextBlock Name="PlaceholderTextBlock"
                       Margin="{TemplateBinding Padding}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}"
                       IsHitTestVisible="False">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
                  <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>

            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}"
                              IsHitTestVisible="False" />

            <TextBox Name="PART_EditableTextBox"
                     Grid.ColumnSpan="2"
                     Padding="{DynamicResource Fluent.ComboBoxEditableTextPadding}"
                     Foreground="{TemplateBinding Foreground}"
                     FontSize="{TemplateBinding FontSize}"
                     Text="{TemplateBinding Text, Mode=TwoWay}"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     IsVisible="{TemplateBinding IsEditable}"
                     Theme="{StaticResource Fluent.ComboBoxTextBox}" />

            <Border Name="DropDownOverlay"
                    Grid.Column="1"
                    Margin="4"
                    Width="30"
                    Background="Transparent"
                    CornerRadius="{DynamicResource Fluent.ComboBoxDropDownButtonBackgroundCornerRadius}"
                    IsVisible="{TemplateBinding IsEditable}" />

            <ToggleButton Name="ToggleButton"
                          Grid.Column="1"
                          Margin="4"
                          IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                          IsVisible="{TemplateBinding IsEditable}"
                          Theme="{StaticResource Fluent.ComboBoxToggleButton}" />

            <TextBlock Name="ChevronIcon"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       RenderTransformOrigin="50%,50%"
                       RenderTransform="rotate(0deg)"
                       Foreground="{DynamicResource Fluent.ComboBoxDropDownGlyphForeground}"
                       FontFamily="{DynamicResource Fluent.SymbolThemeFontFamily}"
                       FontSize="{DynamicResource Fluent.ComboBoxChevronSize}"
                       Text="{x:Static wpf:FluentGlyph.ChevronDown}">
              <TextBlock.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="{x:Static wpf:FluentTimings.Fast}" />
                </Transitions>
              </TextBlock.Transitions>
            </TextBlock>

            <Popup Name="PART_Popup"
                   OverlayInputPassThroughElement="{Binding $parent[ComboBox]}"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   PlacementTarget="ContentBorder"
                   Placement="Bottom"
                   VerticalOffset="1"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border Name="DropDownBorder"
                      Padding="0,4,0,6"
                      Background="{DynamicResource Fluent.ComboBoxDropDownBackground}"
                      BorderBrush="{DynamicResource Fluent.ComboBoxDropDownBorderBrush}"
                      BorderThickness="1.5"
                      CornerRadius="{DynamicResource Fluent.PopupCornerRadius}"
                      HorizontalAlignment="Stretch"
                      UseLayoutRounding="True">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="20" OffsetX="0" OffsetY="6" Opacity="0.25" />
                </Border.Effect>
                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsScrollChainingEnabled="False"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  KeyboardNavigation.TabNavigation="Continue" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- IsDropDownOpen Enter/Exit: the chevron turns, the panel slides in. -->
    <Style Selector="^:dropdownopen">
      <Style Selector="^ /template/ TextBlock#ChevronIcon">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
      </Style>
      <Style Selector="^ /template/ Border#DropDownBorder">
        <Style.Animations>
          <Animation Duration="{x:Static wpf:FluentTimings.Fast}" Easing="CircularEaseOut" FillMode="Forward">
            <KeyFrame Cue="0%">
              <Setter Property="TranslateTransform.Y" Value="-90" />
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="TranslateTransform.Y" Value="0" />
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </Style>

    <!-- HasItems False -->
    <Style Selector="^[ItemCount=0] /template/ Border#DropDownBorder">
      <Setter Property="MinHeight" Value="{DynamicResource Fluent.ComboBoxPopupMinHeight}" />
    </Style>

    <!-- PointerOver -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#ContentBorder">
        <Setter Property="Background" Value="{DynamicResource Fluent.ComboBoxBackgroundPointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ComboBoxBorderBrushPointerOver}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxForegroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ TextBox#PART_EditableTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxForegroundPointerOver}" />
      </Style>
    </Style>

    <!-- Pressed -->
    <Style Selector="^[IsEditable=False]:pressed">
      <Style Selector="^ /template/ Border#ContentBorder">
        <Setter Property="Background" Value="{DynamicResource Fluent.ComboBoxBackgroundPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ComboBoxBorderBrushPressed}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxForegroundPressed}" />
      </Style>
    </Style>

    <!-- Focused / TextBoxFocused -->
    <Style Selector="^:focus-within">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxForegroundFocused}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#ChevronIcon">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxDropDownGlyphForegroundFocused}" />
      </Style>
      <Style Selector="^ /template/ TextBox#PART_EditableTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxForegroundFocused}" />
      </Style>
    </Style>
    <Style Selector="^[IsEditable=True]:focus-within /template/ TextBlock#ChevronIcon">
      <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxEditableDropDownGlyphForeground}" />
    </Style>

    <!-- TextBoxOverlayPointerOver / TextBoxOverlayPressed (editable) -->
    <Style Selector="^ /template/ ToggleButton#ToggleButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Fluent.ComboBoxDropDownBackgroundPointerOver}" />
    </Style>
    <Style Selector="^ /template/ ToggleButton#ToggleButton:pressed">
      <Setter Property="Background" Value="{DynamicResource Fluent.ComboBoxDropDownBackgroundPointerPressed}" />
    </Style>

    <!-- FocusedPressed -->
    <Style Selector="^:focus-within:pressed">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxForegroundFocusedPressed}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#ChevronIcon">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxDropDownGlyphForegroundFocusedPressed}" />
      </Style>
    </Style>
    <Style Selector="^:focus-within /template/ ToggleButton#ToggleButton:pressed">
      <Setter Property="Background" Value="{DynamicResource Fluent.ComboBoxFocusedDropDownBackgroundPointerPressed}" />
    </Style>

    <!-- Disabled -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#ContentBorder">
        <Setter Property="Background" Value="{DynamicResource Fluent.ComboBoxBackgroundDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ComboBoxBorderBrushDisabled}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxForegroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ TextBox#PART_EditableTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxForegroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#ChevronIcon">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.ComboBoxDropDownGlyphForegroundDisabled}" />
      </Style>
    </Style>

    <Style Selector="^[IsEditable=True]">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
