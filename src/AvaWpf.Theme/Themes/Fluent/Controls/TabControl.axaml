<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/TabControl.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    WPF DefaultTabControlStyle. WPF's four templates differ only in header placement, so one template docks the items by
    TabStripPlacement.
  -->
  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
    <Setter Property="Foreground" Value="{DynamicResource Fluent.TabViewForeground}" />
    <Setter Property="Background" Value="{DynamicResource Fluent.TabViewBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fluent.TabViewBorderBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ZIndex="1"
                          Margin="0"
                          ItemsPanel="{TemplateBinding ItemsPanel}"
                          DockPanel.Dock="{TemplateBinding TabStripPlacement}" />
          <Border Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="0,4,4,4"
                  ClipToBounds="True">
            <Panel>
              <ContentPresenter Name="PART_SelectedContentHost2"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Foreground="{TemplateBinding Foreground}"
                                IsVisible="False" />
              <ContentPresenter Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Foreground="{TemplateBinding Foreground}" />
            </Panel>
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[TabStripPlacement=Bottom]">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left]">
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
        <Setter Property="Orientation" Value="Vertical" />
      </Style>
    </Style>
    <Style Selector="^[TabStripPlacement=Right]">
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
        <Setter Property="Orientation" Value="Vertical" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
