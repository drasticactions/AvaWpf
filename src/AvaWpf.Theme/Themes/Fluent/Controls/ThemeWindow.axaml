<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/Window.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!-- ThemeWindow with the Fluent window colors; the Fluent WindowFrame draws the caption, corners and shadow. -->
  <ControlTheme x:Key="{x:Type wpf:ThemeWindow}" TargetType="wpf:ThemeWindow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource Fluent.WindowBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Fluent.WindowForeground}" />
    <Setter Property="FontFamily" Value="{DynamicResource SystemFonts.MessageFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource Fluent.ControlContentThemeFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <VisualLayerManager Name="PART_VisualLayerManager">
            <wpf:WindowFrame Name="PART_Frame"
                             Title="{TemplateBinding Title}"
                             Icon="{TemplateBinding FrameIcon}"
                             ShowIcon="{TemplateBinding ShowFrameIcon}"
                             ShowTitle="{TemplateBinding ShowFrameTitle}"
                             IsActive="{TemplateBinding IsActive}"
                             WindowState="{TemplateBinding WindowState}"
                             Kind="{TemplateBinding FrameKind}"
                             CanMinimize="{TemplateBinding CanMinimize}"
                             CanMaximize="{TemplateBinding CanMaximize}"
                             CanResize="{TemplateBinding CanResize}"
                             MenuBar="{TemplateBinding MenuBar}"
                             CaptionContent="{TemplateBinding CaptionContent}"
                             CaptionOverlay="{TemplateBinding CaptionOverlay}"
                             IsShadowVisible="{TemplateBinding IsShadowVisible}"
                             IsBackdropVisible="{TemplateBinding IsBackdropVisible}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Background="{DynamicResource Fluent.WindowBackground}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </wpf:WindowFrame>
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- Mica granted: the client area lets the backdrop show through, as DefaultWindowStyle does on Windows 11. -->
    <Style Selector="^[IsBackdropVisible=True] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
