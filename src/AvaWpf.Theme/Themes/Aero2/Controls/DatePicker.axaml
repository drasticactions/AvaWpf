<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- A day / month / year picker in the Aero2 ComboBox look; the DatePickerPresenter drops down below it. -->
  <ControlTheme x:Key="{x:Type DatePicker}" TargetType="DatePicker">
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.WindowTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource Aero2.ComboBox.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ComboBox.Static.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="MaxWidth" Value="456" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid Name="LayoutRoot" Margin="{TemplateBinding Padding}">
            <Button Name="PART_FlyoutButton"
                    Theme="{StaticResource Aero2.DateTimePickerFlyoutButton}"
                    Classes.open="{Binding #PART_Popup.IsOpen}"
                    Foreground="{TemplateBinding Foreground}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MaxWidth="{TemplateBinding MaxWidth}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <Grid Name="PART_ButtonContentGrid" ColumnDefinitions="78*,Auto,132*,Auto,78*">
                <TextBlock Name="PART_DayTextBlock"
                           Text="{DynamicResource StringDatePickerDayText}"
                           HorizontalAlignment="Center"
                           Padding="4,3" />
                <TextBlock Name="PART_MonthTextBlock"
                           Text="{DynamicResource StringDatePickerMonthText}"
                           TextAlignment="Left"
                           Padding="6,3,4,3" />
                <TextBlock Name="PART_YearTextBlock"
                           Text="{DynamicResource StringDatePickerYearText}"
                           HorizontalAlignment="Center"
                           Padding="4,3" />
                <Rectangle Name="PART_FirstSpacer"
                           Fill="{DynamicResource Aero2.ComboBox.Static.Border}"
                           HorizontalAlignment="Center"
                           Width="1"
                           Margin="0,3"
                           Grid.Column="1" />
                <Rectangle Name="PART_SecondSpacer"
                           Fill="{DynamicResource Aero2.ComboBox.Static.Border}"
                           HorizontalAlignment="Center"
                           Width="1"
                           Margin="0,3"
                           Grid.Column="3" />
              </Grid>
            </Button>
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsLightDismissEnabled="True"
                   PlacementTarget="{TemplateBinding}"
                   Placement="Bottom"
                   wpf:PopupAnimation.Kind="{DynamicResource SystemParameters.ComboBoxPopupAnimation}">
              <DatePickerPresenter Name="PART_PickerPresenter" />
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled /template/ Rectangle">
      <Setter Property="Fill" Value="{DynamicResource Aero2.ComboBox.Disabled.Border}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="VerticalAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
    </Style>
    <Style Selector="^:hasnodate /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
