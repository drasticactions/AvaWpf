<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    A TableView column header, drawn as WPF GridViewColumnHeader with its gripper. Avalonia's header does not sort, so
    WPF's pressed look is not drawn.
  -->
  <ControlTheme x:Key="Aero2.TableViewColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,-9,0" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Background" Value="{DynamicResource Aero2.GridViewColumnHeaderBorderBackground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
          <Rectangle HorizontalAlignment="Center"
                     Width="1"
                     Fill="{TemplateBinding Background}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Aero2.GridViewColumnHeaderBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Aero2.GridViewColumnHeaderBorderBackground}" />
    <Setter Property="Padding" Value="2,0,2,0" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid UseLayoutRounding="True">
          <Border Name="HeaderBorder"
                  BorderThickness="0,1,0,1"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Background="{TemplateBinding Background}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition MaxHeight="7" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Rectangle Name="UpperHighlight"
                         IsVisible="False"
                         Fill="{DynamicResource Aero2.ListView.GridViewColumnHeader.UpperHighlight.Fill}" />
              <Border Grid.RowSpan="2" Padding="{TemplateBinding Padding}">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Margin="0,0,0,1"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
          </Border>
          <Border Name="HeaderHoverBorder"
                  BorderThickness="1,0,1,1"
                  Margin="1,1,0,0" />
          <Border Name="HeaderPressBorder"
                  BorderThickness="1,1,1,0"
                  Margin="1,0,0,1" />
          <Thumb Name="PART_Resizer"
                 Theme="{StaticResource Aero2.TableViewColumnHeaderGripper}"
                 IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Column?.CanUserEffectivelyResize, FallbackValue=False}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#HeaderBorder">
        <Setter Property="Background" Value="{DynamicResource Aero2.GridViewColumnHeaderHoverBackground}" />
      </Style>
      <Style Selector="^ /template/ Border#HeaderHoverBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ListView.GridViewColumnHeader.HeaderHoverBorder.BorderBrush.IsMouseOver_true}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#UpperHighlight">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Thumb#PART_Resizer">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
