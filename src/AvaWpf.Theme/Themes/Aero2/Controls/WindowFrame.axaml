<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- The Windows 10 window frame. Maximized, the border and shadow go away. -->
  <ControlTheme x:Key="Aero2.WindowFrame.CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="{DynamicResource Aero2.Invented.WindowFrame.ButtonWidth}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Aero2.Invented.WindowFrame.Button.Glyph}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="border" Background="{TemplateBinding Background}">
          <Path Name="glyph"
                Data="{TemplateBinding Content}"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="1"
                Width="10" Height="10"
                Stretch="None"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Aero2.Invented.WindowFrame.Button.Hover.Background}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource Aero2.Invented.WindowFrame.Button.Pressed.Background}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Aero2.Invented.WindowFrame.Button.Disabled.Glyph}" />
    </Style>
    <Style Selector="^.close:pointerover">
      <Setter Property="Background" Value="{DynamicResource Aero2.Invented.WindowFrame.Close.Hover.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource Aero2.Invented.WindowFrame.Close.Hover.Glyph}" />
    </Style>
    <Style Selector="^.close:pressed">
      <Setter Property="Background" Value="{DynamicResource Aero2.Invented.WindowFrame.Close.Pressed.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource Aero2.Invented.WindowFrame.Close.Hover.Glyph}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type wpf:WindowFrame}" TargetType="wpf:WindowFrame">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemColors.AccentColorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.WindowTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="root">
          <Border Name="frame"
                  Background="{DynamicResource Aero2.Invented.WindowFrame.Caption.Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <DockPanel>
              <Grid Name="PART_Caption" DockPanel.Dock="Top"
                    Height="{DynamicResource Aero2.Invented.WindowFrame.CaptionHeight}"
                    Background="Transparent"
                    ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Image Name="icon" Grid.Column="0" Source="{TemplateBinding Icon}" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center" />
                <!-- Caption slots (a RibbonWindow puts its Quick Access Toolbar and contextual tab group headers here). Empty
                     areas are not hit, so they still drag the window through PART_Caption. -->
                <ContentPresenter Name="PART_CaptionContentPresenter" Grid.Column="1"
                                  Content="{TemplateBinding CaptionContent}"
                                  VerticalAlignment="Center"
                                  IsVisible="{TemplateBinding CaptionContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ContentPresenter Name="PART_CaptionOverlayPresenter" Grid.Column="2"
                                  Content="{TemplateBinding CaptionOverlay}"
                                  VerticalAlignment="Stretch"
                                  IsVisible="{TemplateBinding CaptionOverlay, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Name="title" Grid.Column="3"
                           Text="{TemplateBinding Title}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource SystemFonts.CaptionFontFamily}"
                           FontSize="{DynamicResource SystemFonts.CaptionFontSize}"
                           Foreground="{DynamicResource Aero2.Invented.WindowFrame.Caption.Foreground}" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                  <Button Name="PART_MinimizeButton" Theme="{StaticResource Aero2.WindowFrame.CaptionButton}"
                          Content="{DynamicResource Aero2.Invented.WindowFrame.MinimizeGlyph}"
                          IsVisible="{TemplateBinding IsMinimizeButtonVisible}" />
                  <Button Name="PART_MaximizeButton" Theme="{StaticResource Aero2.WindowFrame.CaptionButton}"
                          Content="{DynamicResource Aero2.Invented.WindowFrame.MaximizeGlyph}"
                          IsVisible="{TemplateBinding IsMaximizeButtonVisible}" />
                  <Button Name="PART_CloseButton" Theme="{StaticResource Aero2.WindowFrame.CaptionButton}" Classes="close"
                          Content="{DynamicResource Aero2.Invented.WindowFrame.CloseGlyph}" />
                </StackPanel>
              </Grid>
              <ContentPresenter Name="menu" DockPanel.Dock="Top" Content="{TemplateBinding MenuBar}" IsVisible="{TemplateBinding MenuBar, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </DockPanel>
          </Border>
          <!-- Resize borders: 8 px outside-in hit areas on the edges and corners. -->
          <Panel Name="resize">
            <Border wpf:WindowFrame.ResizeEdge="North" Height="4" VerticalAlignment="Top" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="South" Height="4" VerticalAlignment="Bottom" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="West" Width="4" HorizontalAlignment="Left" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="East" Width="4" HorizontalAlignment="Right" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="NorthWest" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="NorthEast" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="SouthWest" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" />
            <Border wpf:WindowFrame.ResizeEdge="SouthEast" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" />
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:inactive">
      <Setter Property="BorderBrush" Value="{DynamicResource Aero2.Invented.WindowFrame.Border.Inactive}" />
    </Style>
    <Style Selector="^:inactive /template/ TextBlock#title">
      <Setter Property="Foreground" Value="{DynamicResource Aero2.Invented.WindowFrame.Caption.Inactive.Foreground}" />
    </Style>
    <Style Selector="^:inactive /template/ Button">
      <Setter Property="Foreground" Value="{DynamicResource Aero2.Invented.WindowFrame.Button.Glyph.Inactive}" />
    </Style>
    <Style Selector="^:noicon /template/ Image#icon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:shadow /template/ Border#frame">
      <Setter Property="Margin" Value="{DynamicResource Aero2.Invented.WindowFrame.ShadowMargin}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Aero2.Invented.WindowFrame.Shadow}" />
    </Style>
    <Style Selector="^:shadow /template/ Panel#resize">
      <Setter Property="Margin" Value="{DynamicResource Aero2.Invented.WindowFrame.ShadowMargin}" />
    </Style>
    <Style Selector="^:maximized">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:maximized /template/ Panel#resize">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:maximized /template/ Button#PART_MaximizeButton">
      <Setter Property="Content" Value="{DynamicResource Aero2.Invented.WindowFrame.RestoreGlyph}" />
    </Style>
    <Style Selector="^:tool /template/ Grid#PART_Caption">
      <Setter Property="Height" Value="{DynamicResource SystemParameters.SmallCaptionHeight}" />
    </Style>
    <Style Selector="^:tool /template/ TextBlock#title">
      <Setter Property="FontFamily" Value="{DynamicResource SystemFonts.SmallCaptionFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource SystemFonts.SmallCaptionFontSize}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
