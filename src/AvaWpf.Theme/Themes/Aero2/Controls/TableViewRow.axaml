<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!--
    A TableView row, drawn as WPF GridView.GridViewItemContainerStyleKey, in WPF trigger order. The hidden
    PART_ContentPresenter only satisfies ListBoxItem.
  -->
  <ControlTheme x:Key="{x:Type TableViewRow}" TargetType="TableViewRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="0,0,0,1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="RowBd"
                BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="2"
                UseLayoutRounding="True">
          <Border Name="InnerBorder"
                  CornerRadius="1"
                  BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition MaxHeight="11" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Rectangle Name="UpperHighlight"
                         IsVisible="False"
                         Fill="{DynamicResource Aero2.ListViewItem.GridView.GridViewItemContainerStyleKey.UpperHighlight.Fill}" />
              <TableViewCellsPresenter Name="PART_CellsPresenter"
                                       Grid.RowSpan="2"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <ContentPresenter Name="PART_ContentPresenter" IsVisible="False" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Aero2.ListItemHoverFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ListViewItem.GridView.GridViewItemContainerStyleKey.Self.BorderBrush.IsMouseOver_true}" />
      <Style Selector="^ /template/ Rectangle#UpperHighlight">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource Aero2.ListItemSelectedFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ListViewItem.GridView.GridViewItemContainerStyleKey.Self.BorderBrush.IsSelected_true}" />
      <Style Selector="^ /template/ Border#InnerBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ListViewItem.GridView.GridViewItemContainerStyleKey.InnerBorder.BorderBrush.IsSelected_true}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#UpperHighlight">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Fill" Value="{DynamicResource Aero2.ListViewItem.GridView.GridViewItemContainerStyleKey.UpperHighlight.Fill.IsSelected_true}" />
      </Style>
    </Style>
    <Style Selector="^[(wpf|SelectionState.IsSelectionActive)=False]:selected">
      <Setter Property="Background" Value="{DynamicResource Aero2.ListItemSelectedInactiveFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ListViewItem.GridView.GridViewItemContainerStyleKey.Self.BorderBrush.IsSelected_true_IsSelectionActive_false}" />
    </Style>
    <Style Selector="^:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource Aero2.ListItemSelectedHoverFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ListViewItem.GridView.GridViewItemContainerStyleKey.Self.BorderBrush.IsSelected_true_IsMouseOver_true}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
