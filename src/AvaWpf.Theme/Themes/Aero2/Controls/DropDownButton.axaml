<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    A button that opens a flyout: Aero2.BaseButtonStyle with the ComboBox arrow. It keeps the pressed look while the
    flyout is open.
  -->
  <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton" BasedOn="{StaticResource Aero2.BaseButtonStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="4,1,1,1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="border"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                UseLayoutRounding="True">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Focusable="False" />
            <Path Name="Arrow"
                  Grid.Column="1"
                  Margin="4,0,4,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  Fill="{DynamicResource Aero2.ComboBox.Static.Glyph}"
                  Width="5.3334"
                  Height="4.44833"
                  UseLayoutRounding="False"
                  Data="{DynamicResource Aero2.DropDownArrowGeometry}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:flyout-open /template/ Border#border">
      <Setter Property="Background" Value="{DynamicResource Aero2.Button.Pressed.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Aero2.Button.Pressed.Border}" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource Aero2.ComboBox.MouseOver.Glyph}" />
    </Style>
    <Style Selector="^:pressed /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource Aero2.ComboBox.Pressed.Glyph}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource Aero2.ComboBox.Disabled.Glyph}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
