<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF ScrollBar.xaml parts, Aero2.NormalColor: Aero2.ScrollBarLineButton (ScrollBarButton), Aero2.ScrollBarPageButton
    (RepeatButtonTransparent) and Aero2.ScrollBarThumb (ScrollBarThumbVertical/Horizontal).
  -->
  <ControlTheme x:Key="Aero2.ScrollBarLineButton" TargetType="RepeatButton">
    <Setter Property="FocusAdorner" Value="{DynamicResource Aero2.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Aero2.ScrollBar.Static.Glyph}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="border"
                BorderThickness="1"
                UseLayoutRounding="True"
                Background="{DynamicResource Aero2.ScrollBar.Static.Background}"
                BorderBrush="{DynamicResource Aero2.ScrollBar.Static.Border}">
          <Panel Name="contentPresenter"
                 Margin="{TemplateBinding Padding}"
                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <Path Name="arrow"
                  Stretch="Uniform"
                  IsVisible="False"
                  Fill="{TemplateBinding Foreground}" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Focusable="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.up /template/ Path#arrow">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Margin" Value="3,4,3,3" />
      <Setter Property="Data" Value="{DynamicResource Aero2.ScrollBar.ScrollBar.ArrowTop.Data}" />
    </Style>
    <Style Selector="^.down /template/ Path#arrow">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Margin" Value="3,4,3,3" />
      <Setter Property="Data" Value="{DynamicResource Aero2.ScrollBar.ScrollBar.ArrowBottom.Data}" />
    </Style>
    <Style Selector="^.left /template/ Path#arrow">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Data" Value="{DynamicResource Aero2.ScrollBar.ScrollBar.ArrowLeft.Data}" />
    </Style>
    <Style Selector="^.right /template/ Path#arrow">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Data" Value="{DynamicResource Aero2.ScrollBar.ScrollBar.ArrowRight.Data}" />
    </Style>
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource Aero2.ScrollBar.MouseOver.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ScrollBar.MouseOver.Border}" />
      </Style>
      <Style Selector="^ /template/ Path#arrow">
        <Setter Property="Fill" Value="{DynamicResource Aero2.ScrollBar.MouseOver.Glyph}" />
      </Style>
    </Style>
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource Aero2.ScrollBar.Pressed.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ScrollBar.Pressed.Border}" />
      </Style>
      <Style Selector="^:pointerover /template/ Path#arrow">
        <Setter Property="Fill" Value="{DynamicResource Aero2.ScrollBar.Pressed.Glyph}" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Panel#contentPresenter">
        <Setter Property="Opacity" Value="0.56" />
      </Style>
      <Style Selector="^ /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource Aero2.ScrollBar.Disabled.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aero2.ScrollBar.Disabled.Border}" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Aero2.ScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Rectangle Fill="{TemplateBinding Background}"
                   Height="{TemplateBinding Height}"
                   Width="{TemplateBinding Width}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="Aero2.ScrollBarThumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Rectangle Name="rectangle"
                   UseLayoutRounding="True"
                   Fill="{DynamicResource Aero2.ScrollBar.Static.Thumb}"
                   Height="{TemplateBinding Height}"
                   Width="{TemplateBinding Width}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Rectangle#rectangle">
      <Setter Property="Fill" Value="{DynamicResource Aero2.ScrollBar.MouseOver.Thumb}" />
    </Style>
    <Style Selector="^:pressed /template/ Rectangle#rectangle">
      <Setter Property="Fill" Value="{DynamicResource Aero2.ScrollBar.Pressed.Thumb}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
