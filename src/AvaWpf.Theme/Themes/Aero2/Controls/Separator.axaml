<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF Separator.xaml; classes toolbar (ToolBar.SeparatorStyleKey) and statusbar (StatusBar.SeparatorStyleKey); :menu
    is WPF MenuItem.SeparatorStyleKey. Aero2 has its own file because the status bar separator color differs per family.
  -->
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource SystemColors.ControlDarkBrush}" />
    <Setter Property="Margin" Value="0,2,0,2" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                UseLayoutRounding="True"
                Height="1" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^.toolbar">
      <Setter Property="Background" Value="{DynamicResource Aero2.ToolBarSeparatorFill}" />
      <Setter Property="MinWidth" Value="1" />
      <Setter Property="MinHeight" Value="1" />
      <Setter Property="Margin" Value="2,2,2,2" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  UseLayoutRounding="True" />
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:menu">
      <Setter Property="Background" Value="{DynamicResource Aero2.Menu.Static.Separator}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Aero2.Menu.Static.Separator}" />
      <Setter Property="MinHeight" Value="1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  UseLayoutRounding="True"
                  Margin="30,0,0,0" />
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^.statusbar">
      <Setter Property="Background" Value="{DynamicResource SystemColors.ControlDarkDarkBrush}" />
      <Setter Property="MinWidth" Value="1" />
      <Setter Property="MinHeight" Value="1" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  UseLayoutRounding="True" />
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
