<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A cell of WPF's GridViewRowPresenter: 6 px side padding, no look of its own. -->
  <ControlTheme x:Key="{x:Type TableViewCell}" TargetType="TableViewCell">
    <Setter Property="Padding" Value="6,0" />
  </ControlTheme>
</ResourceDictionary>
