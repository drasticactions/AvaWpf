<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF Separator.xaml; :menu is WPF MenuItem.SeparatorStyleKey. The statusbar and toolbar classes are WPF
    StatusBar.SeparatorStyleKey and ToolBar.SeparatorStyleKey.
  -->
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource SystemColors.ControlDarkBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="line"
                Margin="0,2,0,2"
                Height="1"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                UseLayoutRounding="True" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:menu">
      <Setter Property="MinHeight" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Margin="30,0,0,0"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  UseLayoutRounding="True" />
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- StatusBar.SeparatorStyleKey. -->
    <Style Selector="^.statusbar">
      <Setter Property="Background" Value="{DynamicResource SystemColors.ControlLightBrush}" />
      <Setter Property="MinWidth" Value="1" />
      <Setter Property="MinHeight" Value="1" />
      <Style Selector="^ /template/ Border#line">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Width" Value="1" />
      </Style>
    </Style>

    <!-- ToolBar.SeparatorStyleKey. -->
    <Style Selector="^.toolbar">
      <Setter Property="Background" Value="{DynamicResource AeroLite.ToolBarSeparatorFill}" />
      <Setter Property="MinWidth" Value="1" />
      <Setter Property="MinHeight" Value="1" />
      <Style Selector="^ /template/ Border#line">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Width" Value="1" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
