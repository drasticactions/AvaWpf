<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF ScrollBar.xaml, AeroLite.NormalColor. The line buttons are enabled only while the pointer is over the bar, as in
    WPF. The track stays enabled: disabling it when the pointer leaves would end a thumb drag.
  -->
  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="AllowAutoHide" Value="False" />
    <Setter Property="Background" Value="{DynamicResource AeroLite.ScrollBar.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.ScrollBar.Static.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="BorderThickness" Value="1,0" />
    <Setter Property="Width" Value="{DynamicResource SystemParameters.VerticalScrollBarWidth}" />
    <Setter Property="MinWidth" Value="{DynamicResource SystemParameters.VerticalScrollBarWidth}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="Bg" UseLayoutRounding="True">
          <Grid.RowDefinitions>
            <RowDefinition MaxHeight="{DynamicResource SystemParameters.VerticalScrollBarButtonHeight}" />
            <RowDefinition Height="0.00001*" />
            <RowDefinition MaxHeight="{DynamicResource SystemParameters.VerticalScrollBarButtonHeight}" />
          </Grid.RowDefinitions>
          <Border BorderThickness="{TemplateBinding BorderThickness}"
                  Grid.Row="1"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" />
          <RepeatButton Name="PART_LineUpButton"
                        Classes="up"
                        Theme="{StaticResource AeroLite.ScrollBarLineButton}"
                        IsEnabled="{Binding IsPointerOver, RelativeSource={RelativeSource TemplatedParent}}" />
          <Track Name="PART_Track"
                 Grid.Row="1"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                 Orientation="Vertical"
                 IsDirectionReversed="True">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource AeroLite.ScrollBarPageButton}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource AeroLite.ScrollBarPageButton}" />
            </Track.IncreaseButton>
            <Thumb Classes="vertical" Theme="{StaticResource AeroLite.ScrollBarThumb}" />
          </Track>
          <RepeatButton Name="PART_LineDownButton"
                        Grid.Row="2"
                        Classes="down"
                        Theme="{StaticResource AeroLite.ScrollBarLineButton}"
                        IsEnabled="{Binding IsPointerOver, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:horizontal">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="{DynamicResource SystemParameters.HorizontalScrollBarHeight}" />
      <Setter Property="MinHeight" Value="{DynamicResource SystemParameters.HorizontalScrollBarHeight}" />
      <Setter Property="BorderThickness" Value="0,1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="Bg" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition MaxWidth="{DynamicResource SystemParameters.HorizontalScrollBarButtonWidth}" />
              <ColumnDefinition Width="0.00001*" />
              <ColumnDefinition MaxWidth="{DynamicResource SystemParameters.HorizontalScrollBarButtonWidth}" />
            </Grid.ColumnDefinitions>
            <Border BorderThickness="{TemplateBinding BorderThickness}"
                    Grid.Column="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" />
            <RepeatButton Name="PART_LineUpButton"
                          Classes="left"
                          Theme="{StaticResource AeroLite.ScrollBarLineButton}"
                          IsEnabled="{Binding IsPointerOver, RelativeSource={RelativeSource TemplatedParent}}" />
            <Track Name="PART_Track"
                   Grid.Column="1"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                   Orientation="Horizontal">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource AeroLite.ScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource AeroLite.ScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb Classes="horizontal" Theme="{StaticResource AeroLite.ScrollBarThumb}" />
            </Track>
            <RepeatButton Name="PART_LineDownButton"
                          Grid.Column="2"
                          Classes="right"
                          Theme="{StaticResource AeroLite.ScrollBarLineButton}"
                          IsEnabled="{Binding IsPointerOver, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
