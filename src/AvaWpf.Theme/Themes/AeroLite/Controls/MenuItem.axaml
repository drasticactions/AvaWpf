<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF MenuItem.xaml MenuItem style, AeroLite.NormalColor; role templates in _Menus.axaml. A header of "-" makes a
    separator.
  -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template" Value="{StaticResource AeroLite.MenuItem.SubmenuItemTemplate}" />
    <Style Selector="^:not(:empty)">
      <Setter Property="Template" Value="{StaticResource AeroLite.MenuItem.SubmenuHeaderTemplate}" />
    </Style>
    <Style Selector="^:icon /template/ ContentPresenter#Icon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked">
      <Style Selector="^ /template/ Border#GlyphPanel">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#Icon">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </Style>
    <Style Selector="^:selected /template/ Border#templateRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.MenuItem.Highlight.Border}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AeroLite.MenuItem.Highlight.Foreground}" />
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#templateRoot">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AeroLite.MenuItem.Disabled.Foreground}" />
      </Style>
      <Style Selector="^ /template/ Path#Glyph">
        <Setter Property="Fill" Value="{DynamicResource AeroLite.MenuItem.Disabled.Foreground}" />
      </Style>
      <Style Selector="^ /template/ Path#RightArrow">
        <Setter Property="Fill" Value="{DynamicResource AeroLite.MenuItem.Disabled.Foreground}" />
      </Style>
    </Style>
    <Style Selector="^:separator">
      <Setter Property="Template">
        <ControlTemplate>
          <Separator />
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
