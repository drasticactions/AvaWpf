<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:AvaWpf.Chrome.AeroLite">
  <!-- WPF ListView.xaml GridViewColumnHeader, AeroLite.NormalColor, drawn as the DataGridHeaderBorder chrome. -->
  <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="Padding" Value="2,0,2,0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel UseLayoutRounding="True">
          <chrome:DataGridHeaderBorder Name="HeaderBorder"
                                       IsHovered="{TemplateBinding IsPointerOver}"
                                       IsClickable="True"
                                       SeparatorBrush="{DynamicResource AeroLite.ListView.GridViewColumnHeader.Setter.Self.BorderBrush}">
            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </chrome:DataGridHeaderBorder>
          <Thumb Name="PART_Resizer"
                 Template="{StaticResource AeroLite.TableViewColumnHeaderGripper}"
                 Background="Transparent"
                 Width="18"
                 HorizontalAlignment="Right"
                 Margin="0,0,-9,0"
                 Cursor="SizeWestEast"
                 IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Column?.CanUserEffectivelyResize, FallbackValue=False}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
