<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    AeroLite glyph geometries from WPF MenuItem.xaml; the same data is in the AeroLite arrow and Checkmark tokens. The
    left arrow is the right arrow mirrored.
  -->
  <StreamGeometry x:Key="AeroLite.ArrowDownGeometry">M 0,0 L 3.5,4 L 7,0 Z</StreamGeometry>
  <StreamGeometry x:Key="AeroLite.ArrowUpGeometry">M 0,4 L 3.5,0 L 7,4 Z</StreamGeometry>
  <StreamGeometry x:Key="AeroLite.ArrowRightGeometry">M 0,0 L 4,3.5 L 0,7 Z</StreamGeometry>
  <StreamGeometry x:Key="AeroLite.ArrowLeftGeometry">M 4,0 L 0,3.5 L 4,7 Z</StreamGeometry>
  <StreamGeometry x:Key="AeroLite.CheckMarkGeometry">M 0,5.1 L 1.7,5.2 L 3.4,7.1 L 8,0.4 L 9.2,0 L 3.3,10.8 Z</StreamGeometry>
</ResourceDictionary>
