<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF TabControl.xaml, AeroLite.NormalColor. -->
  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource AeroLite.TabItem.Selected.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.TabItem.Selected.Border}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel Name="templateRoot"
                   ClipToBounds="True"
                   UseLayoutRounding="True"
                   KeyboardNavigation.TabNavigation="Local">
          <ItemsPresenter Name="PART_ItemsPresenter"
                          DockPanel.Dock="{TemplateBinding TabStripPlacement}"
                          ItemsPanel="{TemplateBinding ItemsPanel}"
                          Margin="2,2,2,0"
                          ZIndex="1"
                          KeyboardNavigation.TabIndex="1" />
          <Border Name="ContentPanel"
                  KeyboardNavigation.TabNavigation="Local"
                  KeyboardNavigation.TabIndex="2"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}">
            <Panel ClipToBounds="True" Margin="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_SelectedContentHost2"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsVisible="False" />
              <ContentPresenter Name="PART_SelectedContentHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Panel>
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="2,0,2,2" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="2,2,0,2" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="0,2,2,2" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
      <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
      <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <Style Selector="^:disabled /template/ DockPanel#templateRoot">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
