<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF CheckBox.xaml, AeroLite.NormalColor. With content, the focus rectangle goes around the label only. The toolbar
    class is WPF ToolBar.CheckBoxStyleKey.
  -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="FocusAdorner" Value="{DynamicResource AeroLite.OptionMarkFocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource AeroLite.OptionMark.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.OptionMark.Static.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4,-1,0,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="templateRoot" UseLayoutRounding="True" Background="Transparent" ColumnDefinitions="Auto,*">
          <Border Name="checkBoxBorder"
                  Margin="1"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}">
            <Grid Name="markGrid">
              <!-- 8 x 9: WPF measures a Uniform path at its natural size (the geometry bounds) under an infinite
                   constraint; Avalonia stretches it to the row, so the size is given here. -->
              <Path Name="optionMark"
                    Data="{DynamicResource AeroLite.CheckBox.CheckBox.optionMark.Data}"
                    Stretch="Uniform"
                    Width="8"
                    Height="9"
                    Margin="2,1,1,1"
                    Opacity="0"
                    Fill="{TemplateBinding Foreground}" />
              <Rectangle Name="indeterminateMark"
                         Margin="2"
                         Opacity="0"
                         Fill="{TemplateBinding Foreground}" />
            </Grid>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:empty">
      <Setter Property="FocusAdorner" Value="{DynamicResource AeroLite.FocusVisual}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#checkBoxBorder">
        <Setter Property="Background" Value="{DynamicResource AeroLite.OptionMark.MouseOver.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.OptionMark.MouseOver.Border}" />
      </Style>
      <Style Selector="^ /template/ Path#optionMark">
        <Setter Property="Fill" Value="{DynamicResource AeroLite.OptionMark.MouseOver.Glyph}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#indeterminateMark">
        <Setter Property="Fill" Value="{DynamicResource AeroLite.OptionMark.MouseOver.Glyph}" />
      </Style>
    </Style>
    <Style Selector="^:disabled /template/ Grid#templateRoot">
      <Setter Property="Opacity" Value="0.56" />
    </Style>
    <Style Selector="^:checked">
      <Style Selector="^ /template/ Path#optionMark">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ Rectangle#indeterminateMark">
        <Setter Property="Opacity" Value="0" />
      </Style>
    </Style>
    <Style Selector="^:indeterminate">
      <Style Selector="^ /template/ Path#optionMark">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^ /template/ Rectangle#indeterminateMark">
        <Setter Property="Opacity" Value="0.56" />
      </Style>
    </Style>

    <!-- ToolBar.CheckBoxStyleKey: BasedOn ToolBar.ToggleButtonStyleKey. -->
    <Style Selector="^.toolbar">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  UseLayoutRounding="True">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked">
        <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.ToolBarButtonHoverBorder}" />
        <Setter Property="Background" Value="{DynamicResource AeroLite.ToolBarButtonChecked}" />
      </Style>
      <Style Selector="^:pointerover, ^:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.ToolBarButtonHoverBorder}" />
        <Setter Property="Background" Value="{DynamicResource AeroLite.ToolBarButtonHover}" />
      </Style>
      <Style Selector="^:pointerover:checked, ^:focus:checked">
        <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.ToolBarButtonPressedBorder}" />
        <Setter Property="Background" Value="{DynamicResource AeroLite.ToolBarButtonPressed}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.ToolBarButtonPressedBorder}" />
        <Setter Property="Background" Value="{DynamicResource AeroLite.ToolBarButtonPressed}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
