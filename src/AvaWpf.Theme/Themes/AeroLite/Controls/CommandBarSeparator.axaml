<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF ToolBar.SeparatorStyleKey with the AeroLite separator color; horizontal in the overflow menu. -->
  <ControlTheme x:Key="{x:Type CommandBarSeparator}" TargetType="CommandBarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="MinHeight" Value="1" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource AeroLite.ToolBarSeparatorFill}"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                MinHeight="{TemplateBinding MinHeight}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="2" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
