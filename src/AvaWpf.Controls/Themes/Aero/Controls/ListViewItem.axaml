<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- WPF ListViewItemFocusVisual, Aero.NormalColor. -->
  <FocusAdornerTemplate x:Key="Aero.ListViewItemFocusVisual">
    <Rectangle StrokeThickness="1"
               RadiusX="2"
               RadiusY="2"
               Stroke="{DynamicResource Aero.ListViewItem.ListViewItemFocusVisual.Rectangle#1.Stroke}" />
  </FocusAdornerTemplate>

  <!--
    WPF ListViewItem, Aero.NormalColor: the ListBoxItem look without a view, GridView.GridViewItemContainerStyleKey
    with a GridView. The WPF trigger order is kept.
  -->
  <ControlTheme x:Key="{x:Type wpf:ListViewItem}" TargetType="wpf:ListViewItem">
    <Setter Property="Padding" Value="2,0,0,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{DynamicResource Aero.FocusVisualStyle}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}"
                UseLayoutRounding="True">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected:not(:gridview)">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.HighlightTextBrush}" />
      <Style Selector="^ /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SystemColors.HighlightBrush}" />
      </Style>
    </Style>
    <Style Selector="^:selected:not(:selectionactive):not(:gridview)">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.InactiveSelectionHighlightTextBrush}" />
      <Style Selector="^ /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SystemColors.InactiveSelectionHighlightBrush}" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>

    <Style Selector="^:gridview">
      <Setter Property="FocusAdorner" Value="{StaticResource Aero.ListViewItemFocusVisual}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,1" />
      <Setter Property="Padding" Value="5,2,5,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="RowBd"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="2"
                  UseLayoutRounding="True">
            <Border Name="InnerBorder"
                    CornerRadius="1"
                    BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition MaxHeight="11" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Rectangle Name="UpperHighlight"
                           IsVisible="False"
                           Fill="{DynamicResource Aero.ListViewItem.GridView.GridViewItemContainerStyleKey.UpperHighlight.Fill}" />
                <!-- WPF leaves out HorizontalAlignment: the header row cannot center or right-align either. -->
                <wpf:GridViewRowPresenter Name="PART_RowPresenter"
                                          Grid.RowSpan="2"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          UseLayoutRounding="True" />
              </Grid>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Aero.ListItemHoverFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.ListViewItem.GridView.GridViewItemContainerStyleKey.Self.BorderBrush.IsMouseOver_true}" />
        <Style Selector="^ /template/ Rectangle#UpperHighlight">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{DynamicResource Aero.ListItemSelectedFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.ListViewItem.GridView.GridViewItemContainerStyleKey.Self.BorderBrush.IsSelected_true}" />
        <Style Selector="^ /template/ Border#InnerBorder">
          <Setter Property="BorderBrush" Value="{DynamicResource Aero.ListViewItem.GridView.GridViewItemContainerStyleKey.InnerBorder.BorderBrush.IsSelected_true}" />
        </Style>
        <Style Selector="^ /template/ Rectangle#UpperHighlight">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="Fill" Value="{DynamicResource Aero.ListViewItem.GridView.GridViewItemContainerStyleKey.UpperHighlight.Fill.IsSelected_true}" />
        </Style>
      </Style>
      <Style Selector="^:selected:not(:selectionactive)">
        <Setter Property="Background" Value="{DynamicResource Aero.ListItemSelectedInactiveFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.ListViewItem.GridView.GridViewItemContainerStyleKey.Self.BorderBrush.IsSelected_true_IsSelectionActive_false}" />
      </Style>
      <Style Selector="^:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Aero.ListItemSelectedHoverFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.ListViewItem.GridView.GridViewItemContainerStyleKey.Self.BorderBrush.IsSelected_true_IsMouseOver_true}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
