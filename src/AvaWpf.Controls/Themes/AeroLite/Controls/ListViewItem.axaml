<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!--
    WPF ListViewItem, AeroLite.NormalColor: the ListBoxItem look without a view,
    GridView.GridViewItemContainerStyleKey with a GridView.
  -->
  <ControlTheme x:Key="{x:Type wpf:ListViewItem}" TargetType="wpf:ListViewItem">
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusAdorner" Value="{DynamicResource AeroLite.FocusVisual}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}"
                UseLayoutRounding="True">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource AeroLite.Item.MouseOver.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.Item.MouseOver.Border}" />
    </Style>
    <Style Selector="^:selected:not(:selectionactive) /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource AeroLite.Item.SelectedInactive.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.Item.SelectedInactive.Border}" />
    </Style>
    <Style Selector="^:selected:selectionactive /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource AeroLite.Item.SelectedActive.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AeroLite.Item.SelectedActive.Border}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>

    <Style Selector="^:gridview">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}"
                  UseLayoutRounding="True">
            <!-- WPF leaves out HorizontalAlignment: the header row cannot center or right-align either. -->
            <wpf:GridViewRowPresenter Name="PART_RowPresenter"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      UseLayoutRounding="True" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
