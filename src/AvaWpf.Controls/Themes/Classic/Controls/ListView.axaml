<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- WPF ListView, Classic: the ListBox look without a view, GridView.GridViewStyleKey with a GridView. -->
  <ControlTheme x:Key="{x:Type wpf:ListView}" TargetType="wpf:ListView">
    <Setter Property="Background" Value="{DynamicResource SystemColors.WindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.WindowTextBrush}" />
    <Setter Property="BorderBrush" Value="{x:Static wpf:ClassicBorderDecorator.ClassicBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <wpf:ClassicBorderDecorator Name="Bd"
                                    BorderStyle="Sunken"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    UseLayoutRounding="True">
          <ScrollViewer Name="PART_ScrollViewer"
                        Padding="{TemplateBinding Padding}"
                        Focusable="False"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
        </wpf:ClassicBorderDecorator>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled /template/ wpf|ClassicBorderDecorator#Bd">
      <Setter Property="Background" Value="{DynamicResource SystemColors.WindowBrush}" />
    </Style>

    <Style Selector="^:gridview">
      <Setter Property="Template">
        <ControlTemplate>
          <wpf:ClassicBorderDecorator Name="GridBd"
                                      BorderStyle="Sunken"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      UseLayoutRounding="True">
            <ScrollViewer Name="PART_ScrollViewer"
                          Theme="{StaticResource Classic.GridViewScrollViewer}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </wpf:ClassicBorderDecorator>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled /template/ wpf|ClassicBorderDecorator#GridBd">
        <Setter Property="Background" Value="{DynamicResource SystemColors.ControlBrush}" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
