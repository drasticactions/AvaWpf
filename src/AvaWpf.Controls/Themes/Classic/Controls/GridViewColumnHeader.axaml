<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!--
    WPF GridViewColumnHeaderGripper, Classic. The header background is Transparent, so the line never shows; the
    raised bevel is the divider.
  -->
  <ControlTheme x:Key="Classic.GridViewColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,-9,0" />
    <Setter Property="Padding" Value="0,3,0,4" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Background" Value="{DynamicResource Classic.ListView.GridViewColumnHeaderGripper.Setter.Self.Background}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}"
                Background="Transparent">
          <Rectangle HorizontalAlignment="Center"
                     Width="1"
                     Fill="{TemplateBinding Background}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    WPF GridViewColumnHeader, Classic: a Raised ClassicBorderDecorator that turns RaisedPressed when pressed. The 20
    px minimum height applies only while Height is Auto, as in WPF.
  -->
  <ControlTheme x:Key="{x:Type wpf:GridViewColumnHeader}" TargetType="wpf:GridViewColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SystemColors.ControlBrush}" />
    <Setter Property="BorderBrush" Value="{x:Static wpf:ClassicBorderDecorator.ClassicBorderBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="Padding" Value="2,0,2,0" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid UseLayoutRounding="True">
          <wpf:ClassicBorderDecorator Name="ContentContainer"
                                      BorderStyle="Raised"
                                      Background="{TemplateBinding Background}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      BorderBrush="{TemplateBinding BorderBrush}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </wpf:ClassicBorderDecorator>
          <Panel Name="GripperHost">
            <Thumb Name="PART_HeaderGripper"
                   Theme="{StaticResource Classic.GridViewColumnHeaderGripper}"
                   Background="Transparent" />
          </Panel>
          <Border Name="HeaderPressBorder"
                  BorderBrush="{DynamicResource Classic.ListView.GridViewColumnHeader.HeaderPressBorder.BorderBrush}"
                  BorderThickness="1"
                  IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pressed:not(:padding)">
      <Setter Property="Background" Value="{DynamicResource SystemColors.ControlBrush}" />
      <Style Selector="^ /template/ wpf|ClassicBorderDecorator#ContentContainer">
        <Setter Property="BorderStyle" Value="RaisedPressed" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style Selector="^ /template/ Border#HeaderPressBorder">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>

    <!-- Role Padding: the normal header without gripper or content. -->
    <Style Selector="^:padding">
      <Setter Property="Template">
        <ControlTemplate>
          <wpf:ClassicBorderDecorator BorderStyle="Raised"
                                      Background="{TemplateBinding Background}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      BorderBrush="{TemplateBinding BorderBrush}" />
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Role Floating: the copy of the dragged header, painted from the source into the canvas. -->
    <Style Selector="^:floating">
      <Setter Property="Opacity" Value="0.5056" />
      <Setter Property="Template">
        <ControlTemplate>
          <Canvas Name="PART_FloatingHeaderCanvas">
            <Rectangle Opacity="0.3034"
                       Fill="{DynamicResource Classic.ListView.GridViewColumnHeader.Rectangle#1.Fill}"
                       Width="{TemplateBinding Width}"
                       Height="{TemplateBinding Height}" />
          </Canvas>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
