<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF ToolBar.xaml, shared classic section: the helper themes of the ToolBar template. -->

  <!-- ToolBarThumbStyle: the gripper; the Padding insets the dots. -->
  <ControlTheme x:Key="$F.ToolBarThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}"
                Background="Transparent"
                UseLayoutRounding="True">
          <Rectangle Fill="{DynamicResource $F.ToolBar.ToolBarThumbStyle.Rectangle#1.Fill}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
  </ControlTheme>

  <!--
    ToolBarHorizontalOverflowButtonStyle. High contrast renders as Classic, so the WPF high-contrast trigger is not
    ported.
  -->
  <ControlTheme x:Key="$F.ToolBarHorizontalOverflowButtonStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource $F.ToolBarToggleButtonHorizontalBackground}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd"
                CornerRadius="0,3,3,0"
                Background="{TemplateBinding Background}"
                UseLayoutRounding="True">
          <Canvas Width="6"
                  Height="7"
                  Margin="7,2,2,2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom">
            <Path Stroke="{DynamicResource $F.ToolBar.ToolBarHorizontalOverflowButtonStyle.Path#1.Stroke}"
                  Data="{DynamicResource $F.ToolBar.ToolBarHorizontalOverflowButtonStyle.Path#1.Data}" />
            <Path Stroke="{TemplateBinding Foreground}"
                  Data="{DynamicResource $F.ToolBar.ToolBarHorizontalOverflowButtonStyle.Path#2.Data}" />
            <Path Fill="{DynamicResource $F.ToolBar.ToolBarHorizontalOverflowButtonStyle.Path#3.Fill}"
                  Data="{DynamicResource $F.ToolBar.ToolBarHorizontalOverflowButtonStyle.Path#3.Data}" />
            <Path Fill="{TemplateBinding Foreground}"
                  Data="{DynamicResource $F.ToolBar.ToolBarHorizontalOverflowButtonStyle.Path#4.Data}" />
          </Canvas>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource $F.ToolBarButtonHover}" />
    </Style>
    <Style Selector="^:focus /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource $F.ToolBarButtonHover}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource $F.ToolBarGripper}" />
    </Style>
  </ControlTheme>

  <!-- ToolBarVerticalOverflowButtonStyle: the same at the bottom of a vertical bar, rounded at the bottom, glyph turned. -->
  <ControlTheme x:Key="$F.ToolBarVerticalOverflowButtonStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource $F.ToolBarToggleButtonVerticalBackground}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd"
                CornerRadius="0,0,3,3"
                Background="{TemplateBinding Background}"
                UseLayoutRounding="True">
          <Canvas Width="7"
                  Height="6"
                  Margin="2,7,2,2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom">
            <Path Stroke="{DynamicResource $F.ToolBar.ToolBarVerticalOverflowButtonStyle.Path#1.Stroke}"
                  Data="{DynamicResource $F.ToolBar.ToolBarVerticalOverflowButtonStyle.Path#1.Data}" />
            <Path Stroke="{TemplateBinding Foreground}"
                  Data="{DynamicResource $F.ToolBar.ToolBarVerticalOverflowButtonStyle.Path#2.Data}" />
            <Path Fill="{DynamicResource $F.ToolBar.ToolBarVerticalOverflowButtonStyle.Path#3.Fill}"
                  Data="{DynamicResource $F.ToolBar.ToolBarVerticalOverflowButtonStyle.Path#3.Data}" />
            <Path Fill="{TemplateBinding Foreground}"
                  Data="{DynamicResource $F.ToolBar.ToolBarVerticalOverflowButtonStyle.Path#4.Data}" />
          </Canvas>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource $F.ToolBarButtonHover}" />
    </Style>
    <Style Selector="^:focus /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource $F.ToolBarButtonHover}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource $F.ToolBarGripper}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
