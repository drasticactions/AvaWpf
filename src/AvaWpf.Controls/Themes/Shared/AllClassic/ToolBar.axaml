<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!--
    WPF ToolBar style of the shared classic section, with the family brushes. High contrast renders as Classic, so the
    WPF high-contrast triggers are not ported.
  -->
  <ControlTheme x:Key="{x:Type wpf:ToolBar}" TargetType="wpf:ToolBar">
    <Setter Property="Background" Value="{DynamicResource $F.ToolBarHorizontalBackground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="Grid"
              Margin="3,1,1,1"
              UseLayoutRounding="True">
          <Grid Name="OverflowGrid"
                HorizontalAlignment="Right">
            <ToggleButton Name="PART_OverflowButton"
                          Theme="{StaticResource $F.ToolBarHorizontalOverflowButtonStyle}"
                          IsEnabled="{TemplateBinding HasOverflowItems}"
                          IsChecked="{TemplateBinding IsOverflowOpen, Mode=TwoWay}"
                          ClickMode="Press" />
            <Popup Name="OverflowPopup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsOverflowOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="False"
                   wpf:PopupAnimation.Kind="{DynamicResource SystemParameters.ComboBoxPopupAnimation}">
              <!-- WPF sets the shadow margin when Popup.HasDropShadow; the chrome draws no shadow without SystemParameters.DropShadow. -->
              <wpf:SystemDropShadowChrome Name="Shdw"
                                          Margin="0,0,5,5"
                                          UseLayoutRounding="True">
                <Border Name="ToolBarSubMenuBorder"
                        Background="{DynamicResource $F.ToolBarSubMenuBackground}"
                        BorderBrush="{DynamicResource $F.ToolBarMenuBorder}"
                        BorderThickness="1">
                  <wpf:ToolBarOverflowPanel Name="PART_ToolBarOverflowPanel"
                                            Margin="2"
                                            WrapWidth="200"
                                            Focusable="True"
                                            FocusAdorner="{x:Null}"
                                            KeyboardNavigation.TabNavigation="Cycle"
                                            UseLayoutRounding="True" />
                </Border>
              </wpf:SystemDropShadowChrome>
            </Popup>
          </Grid>
          <Border Name="MainPanelBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  Margin="0,0,11,0"
                  CornerRadius="3">
            <DockPanel>
              <Thumb Name="PART_Gripper"
                     Theme="{StaticResource $F.ToolBarThumbStyle}"
                     DockPanel.Dock="Left"
                     Margin="-3,-1,0,0"
                     Width="10"
                     Padding="6,5,1,6" />
              <ContentPresenter Name="PART_HeaderPresenter"
                                DockPanel.Dock="Left"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="4,0,4,0" />
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              Margin="0,1,2,2"
                              UseLayoutRounding="True" />
            </DockPanel>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:overflowopen /template/ Thumb#PART_Gripper">
      <Setter Property="IsEnabled" Value="False" />
    </Style>
    <Style Selector="^:locked /template/ Thumb#PART_Gripper">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:vertical">
      <Setter Property="Background" Value="{DynamicResource $F.ToolBarVerticalBackground}" />
      <Style Selector="^ /template/ Grid#Grid">
        <Setter Property="Margin" Value="1,3,1,1" />
      </Style>
      <Style Selector="^ /template/ ToggleButton#PART_OverflowButton">
        <Setter Property="Theme" Value="{StaticResource $F.ToolBarVerticalOverflowButtonStyle}" />
      </Style>
      <Style Selector="^ /template/ Thumb#PART_Gripper">
        <Setter Property="Height" Value="10" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Margin" Value="-1,-3,0,0" />
        <Setter Property="Padding" Value="5,6,6,1" />
        <Setter Property="DockPanel.Dock" Value="Top" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="DockPanel.Dock" Value="Top" />
      </Style>
      <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="1,0,2,2" />
      </Style>
      <Style Selector="^ /template/ Grid#OverflowGrid">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
      </Style>
      <Style Selector="^ /template/ Popup#OverflowPopup">
        <Setter Property="Placement" Value="Right" />
      </Style>
      <Style Selector="^ /template/ Border#MainPanelBorder">
        <Setter Property="Margin" Value="0,0,0,11" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
