<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- WPF ResizeGrip, Aero.NormalColor, Aero2.NormalColor and AeroLite.NormalColor. -->
  <ControlTheme x:Key="{x:Type wpf:ResizeGrip}" TargetType="wpf:ResizeGrip">
    <Setter Property="MinWidth" Value="{DynamicResource SystemParameters.VerticalScrollBarWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource SystemParameters.HorizontalScrollBarHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="BottomRightCorner" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}"
              UseLayoutRounding="True">
          <Path HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,2,2"
                Data="{DynamicResource $F.ResizeGrip.ResizeGrip.Path#1.Data}"
                Fill="{DynamicResource $F.ResizeGrip.ResizeGrip.Path#1.Fill}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[FlowDirection=RightToLeft]">
      <Setter Property="Cursor" Value="BottomLeftCorner" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
