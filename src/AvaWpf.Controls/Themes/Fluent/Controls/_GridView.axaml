<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/GridView.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!-- WPF Fluent GridView.xaml: the helper themes of the GridView look. -->

  <!--
    The template of the header row viewer: content only. It is set as a template value because a nested ScrollViewer
    in the GridView ScrollViewer template would otherwise take the outer theme template and show a second header row.
  -->
  <ControlTemplate x:Key="Fluent.GridViewHeaderScrollViewerTemplate" TargetType="ScrollViewer">
    <ScrollContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
  </ControlTemplate>

  <!--
    GridView.GridViewScrollViewerStyleKey: the header row scrolls horizontally with the content. The content spans the
    scroll bar row and column, so the bars float over the rows.
  -->
  <ControlTheme x:Key="Fluent.GridViewScrollViewer" TargetType="ScrollViewer">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}"
              ColumnDefinitions="*,Auto"
              RowDefinitions="*,Auto"
              UseLayoutRounding="True">
          <DockPanel Grid.ColumnSpan="2"
                     Grid.RowSpan="2"
                     Margin="{TemplateBinding Padding}">
            <ScrollViewer Name="PART_HeaderScrollViewer"
                          DockPanel.Dock="Top"
                          Template="{StaticResource Fluent.GridViewHeaderScrollViewerTemplate}"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
              <wpf:GridViewHeaderRowPresenter Name="PART_HeaderRowPresenter"
                                              UseLayoutRounding="True" />
            </ScrollViewer>
            <ScrollContentPresenter Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    UseLayoutRounding="True" />
          </DockPanel>
          <ScrollBar Name="PART_HorizontalScrollBar"
                     Orientation="Horizontal"
                     Grid.Row="1"
                     Cursor="Arrow" />
          <ScrollBar Name="PART_VerticalScrollBar"
                     Orientation="Vertical"
                     Grid.Column="1"
                     Cursor="Arrow" />
          <DockPanel Grid.Column="1"
                     Grid.Row="1"
                     Background="{Binding #PART_VerticalScrollBar.Background}"
                     LastChildFill="False">
            <Rectangle DockPanel.Dock="Left"
                       Width="1"
                       Fill="Transparent"
                       IsVisible="{Binding #PART_VerticalScrollBar.IsVisible}" />
            <Rectangle DockPanel.Dock="Top"
                       Height="1"
                       Fill="Transparent"
                       IsVisible="{Binding #PART_HorizontalScrollBar.IsVisible}" />
          </DockPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
