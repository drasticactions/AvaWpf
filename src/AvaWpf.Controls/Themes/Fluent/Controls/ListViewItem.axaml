<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/ListViewItem.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!--
    WPF Fluent DefaultListViewItemStyle; with a GridView, GridView.GridViewItemContainerStyleKey. WPF names
    GridViewItemContainerMinHeight and ListViewItemBackgroundSelectedPointerOver, which no Fluent dictionary defines,
    so a row has no minimum height and selected hover keeps the hover fill.
  -->
  <ControlTheme x:Key="{x:Type wpf:ListViewItem}" TargetType="wpf:ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource Fluent.ListViewItemForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource Fluent.ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="{DynamicResource Fluent.ListViewItemMinHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource Fluent.ListViewItemMinWidth}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="{DynamicResource Fluent.ListViewItemMargin}" />
    <Setter Property="Padding" Value="{DynamicResource Fluent.ListViewItemPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Border"
                Margin="0"
                Padding="0"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                UseLayoutRounding="True">
          <Grid>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Rectangle Name="ActiveRectangle"
                       Width="3"
                       Height="16"
                       Margin="0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Fill="{DynamicResource Fluent.ListViewItemPillFillBrush}"
                       RadiusX="2"
                       RadiusY="2"
                       IsVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover:not(:disabled) /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource Fluent.ListViewItemBackgroundPointerOver}" />
    </Style>
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Rectangle#ActiveRectangle">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource Fluent.ListViewItemBackgroundPointerOver}" />
      </Style>
    </Style>

    <Style Selector="^:gridview">
      <Setter Property="Padding" Value="6,0,6,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Border"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  UseLayoutRounding="True">
            <Grid Name="ContentGrid">
              <!-- WPF leaves out HorizontalAlignment: the header row cannot center or right-align either. -->
              <wpf:GridViewRowPresenter Name="PART_RowPresenter"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        UseLayoutRounding="True" />
              <Rectangle Name="ActiveRectangle"
                         Width="3"
                         Height="16"
                         Margin="0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource Fluent.ListViewItemPillFillBrush}"
                         RadiusX="2"
                         RadiusY="2"
                         IsVisible="False" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
