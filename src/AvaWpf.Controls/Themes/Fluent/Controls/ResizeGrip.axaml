<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/ResizeGrip.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!-- WPF Fluent DefaultResizeGripStyle; as in WPF, the glyph sits at the top-left of the grid. -->
  <ControlTheme x:Key="{x:Type wpf:ResizeGrip}" TargetType="wpf:ResizeGrip">
    <Setter Property="MinWidth" Value="{DynamicResource Fluent.ResizeGripMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource Fluent.ResizeGripMinHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="BottomRightCorner" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}"
              UseLayoutRounding="True">
          <TextBlock FontFamily="{DynamicResource Fluent.SymbolThemeFontFamily}"
                     Text="{x:Static wpf:FluentGlyph.ResizeGrip}"
                     FontSize="{DynamicResource Fluent.ResizeGripIconSize}"
                     Foreground="{DynamicResource Fluent.ResizeGripForeground}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[FlowDirection=RightToLeft]">
      <Setter Property="Cursor" Value="BottomLeftCorner" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
