<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- Ported from WPF PresentationFramework.Fluent/Styles/ToolBar.xaml (MIT, WPF UI contributors; see NOTICE.md). -->
  <!-- WPF Fluent ToolBarTray style. -->
  <ControlTheme x:Key="{x:Type wpf:ToolBarTray}" TargetType="wpf:ToolBarTray">
    <Setter Property="Background" Value="{DynamicResource Fluent.ToolBar.ToolBarTray.Setter.Self.Background}" />
    <Setter Property="Margin" Value="0" />
  </ControlTheme>
</ResourceDictionary>
