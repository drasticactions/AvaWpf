<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- WPF GridViewColumnHeaderGripper, Luna. -->
  <ControlTheme x:Key="Luna.GridViewColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,-9,0" />
    <Setter Property="Padding" Value="0,3,0,4" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Background" Value="{DynamicResource Luna.GridViewColumnHeaderGripperBackground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}"
                Background="Transparent">
          <DockPanel HorizontalAlignment="Center">
            <Rectangle Width="1"
                       Fill="{TemplateBinding Background}" />
            <Rectangle Width="1"
                       Fill="{DynamicResource Luna.ListView.GridViewColumnHeaderGripper.Rectangle#2.Fill}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    WPF GridViewColumnHeader, Luna. The 20 px minimum height applies only while Height is Auto, as in WPF. The brushes
    switch with the scheme; NormalColor and Homestead share one set.
  -->
  <ControlTheme x:Key="{x:Type wpf:GridViewColumnHeader}" TargetType="wpf:GridViewColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Luna.GridViewColumnHeaderBackground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2,0,2,0" />
    <Setter Property="Foreground" Value="{DynamicResource SystemColors.ControlTextBrush}" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}"
              UseLayoutRounding="True">
          <Border Name="HighlightBorder"
                  VerticalAlignment="Bottom"
                  Height="3"
                  BorderThickness="0,0,0,1"
                  Background="{DynamicResource Luna.GridViewColumnHeaderHighlightBackground}"
                  BorderBrush="{DynamicResource Luna.GridViewColumnHeaderDarkBackground}" />
          <Border BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Padding="{TemplateBinding Padding}"
                  Margin="1,0,1,0">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="0,0,0,1"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <Panel Name="GripperHost">
            <Thumb Name="PART_HeaderGripper"
                   Theme="{StaticResource Luna.GridViewColumnHeaderGripper}" />
          </Panel>
          <Border Name="HeaderPressBorder"
                  BorderThickness="1" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover:not(:padding)">
      <Setter Property="Background" Value="{DynamicResource Luna.GridViewColumnHeaderHoverBackground}" />
      <Style Selector="^ /template/ Border#HighlightBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Luna.TabItemHotBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource Luna.TabItemHotBorderBackround}" />
        <Setter Property="CornerRadius" Value="0,0,3,3" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
      </Style>
      <Style Selector="^ /template/ Thumb#PART_HeaderGripper">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
    <Style Selector="^:pressed:not(:padding)">
      <Setter Property="Background" Value="{DynamicResource Luna.GridViewColumnHeaderPressBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Luna.GridViewColumnHeaderPressBackground}" />
      <Style Selector="^ /template/ Border#HighlightBorder">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^ /template/ Thumb#PART_HeaderGripper">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Border#HeaderPressBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Luna.GridViewColumnHeaderPressBorder}" />
        <Setter Property="Margin" Value="1,0,0,0" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="1,1,0,0" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SystemColors.GrayTextBrush}" />
    </Style>

    <!-- Role Floating: the copy of the dragged header, painted from the source into the canvas. -->
    <Style Selector="^:floating">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Template">
        <ControlTemplate>
          <Canvas Name="PART_FloatingHeaderCanvas" />
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Role Padding: the normal header without gripper or content. -->
    <Style Selector="^:padding">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}"
                UseLayoutRounding="True">
            <Border VerticalAlignment="Bottom"
                    Height="3"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource Luna.GridViewColumnHeaderHighlightBackground}"
                    BorderBrush="{DynamicResource Luna.GridViewColumnHeaderDarkBackground}" />
            <Border BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    Padding="{TemplateBinding Padding}"
                    Margin="1,0,1,0" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
