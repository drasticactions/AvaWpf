<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The group header glyph, from WPF ExpanderDownHeaderStyle, Luna and Royale.NormalColor. The WPF hover shadow
    ellipse has no fill, so it is left out.
  -->
  <ControlTheme x:Key="$F.DataGridRowGroupExpanderButton" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Width="19" Height="19" Background="Transparent">
          <Ellipse x:Name="circle" Width="19" Height="19" StrokeThickness="1" Stroke="{DynamicResource $F.Expander.ExpanderDownHeaderStyle.circle.Stroke}" />
          <Path x:Name="arrow"
                Width="8.71"
                Height="6.41"
                UseLayoutRounding="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stroke="{DynamicResource $F.Expander.ExpanderDownHeaderStyle.arrow.Stroke}"
                StrokeThickness="2"
                Data="{DynamicResource $F.Expander.ExpanderDownHeaderStyle.arrow.Data}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Path#arrow">
      <Setter Property="Data" Value="{DynamicResource $F.Expander.ExpanderDownHeaderStyle.arrow.Data.IsChecked_true}" />
      <Setter Property="Height" Value="5.21" />
    </Style>
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Ellipse#circle">
        <Setter Property="Stroke" Value="{DynamicResource $F.Expander.ExpanderDownHeaderStyle.circle.Stroke.IsMouseOver_true}" />
      </Style>
      <Style Selector="^ /template/ Path#arrow">
        <Setter Property="Stroke" Value="{DynamicResource $F.Expander.ExpanderDownHeaderStyle.arrow.Stroke.IsMouseOver_true}" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
