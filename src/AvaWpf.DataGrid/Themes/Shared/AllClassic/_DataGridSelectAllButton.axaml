<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!--
    WPF DataGridSelectAllButtonStyle. The Avalonia corner is a DataGridColumnHeader (PART_TopLeftCornerHeader), so
    this theme targets that type.
  -->
  <ControlTheme x:Key="$F.DataGridSelectAllButtonStyle" TargetType="DataGridColumnHeader">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Rectangle x:Name="Border" StrokeThickness="1" Fill="{DynamicResource SystemColors.ControlBrush}" UseLayoutRounding="True" />
          <Polygon x:Name="Arrow"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="8,8,3,3"
                   Opacity="0.15"
                   Fill="{DynamicResource $F.DataGrid.DataGridSelectAllButtonStyle.Arrow.Fill}"
                   Stretch="Uniform"
                   wpf:DataGridState.Points="{DynamicResource $F.DataGrid.DataGridSelectAllButtonStyle.Arrow.Points}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Rectangle#Border">
      <Setter Property="Stroke" Value="{DynamicResource SystemColors.ControlDarkBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Rectangle#Border">
      <Setter Property="Fill" Value="{DynamicResource SystemColors.ControlDarkBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Polygon#Arrow">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <!--
    WPF DataGridTextColumn.DefaultElementStyle, which Avalonia DataGridTextColumn looks up. The text is centered
    vertically to line up with check box cells.
  -->
  <ControlTheme x:Key="DataGridCellTextBlockTheme" TargetType="TextBlock">
    <Setter Property="Margin" Value="2,0,2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>
</ResourceDictionary>
