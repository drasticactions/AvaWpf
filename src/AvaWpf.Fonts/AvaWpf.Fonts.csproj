<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AvaWpf</RootNamespace>
    <PackageId>AvaWpf.Fonts</PackageId>
    <Description>Open substitute fonts for the WPF themes (Selawik, Wine Tahoma, Wine MS Sans Serif) and the Fluent icon subset.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />

  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**/*.ttf" />
    <None Include="Assets/**/*.txt" Pack="true" PackagePath="licenses\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvaWpf.Theme.Tests" />
  </ItemGroup>

</Project>
