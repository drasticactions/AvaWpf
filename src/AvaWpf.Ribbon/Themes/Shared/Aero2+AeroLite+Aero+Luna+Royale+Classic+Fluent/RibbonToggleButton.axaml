<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- WPF RibbonToggleButton.xaml, [[Generic]]. The "dropdown" class (the toggle of a RibbonMenuButton) adds the drop-down arrow. -->
  <ControlTheme x:Key="{x:Type wpf:RibbonToggleButton}" TargetType="wpf:RibbonToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource $F.Invented.Ribbon.Button.CornerRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="OuterBorder"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                UseLayoutRounding="True">
          <Border Name="MiddleBorder" CornerRadius="{TemplateBinding CornerRadius}">
            <Border Name="InnerBorder"
                    BorderBrush="Transparent"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <StackPanel Name="StackPanel">
                <Image Name="PART_Image"
                       Source="{TemplateBinding LargeImageSource}"
                       Width="32"
                       Height="32"
                       Margin="1,1,1,2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                <Grid Name="Grid" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <wpf:RibbonTwoLineText Name="TwoLineText"
                                         Text="{TemplateBinding Label}"
                                         TextAlignment="Center"
                                         VerticalAlignment="Top"
                                         HorizontalAlignment="Center"
                                         LineHeight="13"
                                         PathFill="{TemplateBinding Foreground}"
                                         Margin="1,1,1,0" />
                </Grid>
              </StackPanel>
            </Border>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.dropdown /template/ wpf|RibbonTwoLineText#TwoLineText">
      <Setter Property="PathData" Value="{DynamicResource $F.Invented.Ribbon.Glyph.DownArrow}" />
    </Style>
    <Style Selector="^:large">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Height" Value="66" />
      <Style Selector="^ /template/ Grid#Grid">
        <Setter Property="MinHeight" Value="26" />
      </Style>
      <Style Selector="^ /template/ wpf|RibbonTwoLineText#TwoLineText">
        <Setter Property="HasTwoLines" Value="True" />
      </Style>
    </Style>
    <Style Selector="^:small">
      <Setter Property="Height" Value="22" />
      <Style Selector="^ /template/ Image#PART_Image">
        <Setter Property="Margin" Value="1,0,1,0" />
        <Setter Property="Source" Value="{TemplateBinding SmallImageSource}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
      </Style>
      <Style Selector="^ /template/ wpf|RibbonTwoLineText#TwoLineText">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="1" />
      </Style>
      <Style Selector="^ /template/ StackPanel#StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
      </Style>
    </Style>
    <Style Selector="^:small:inqat">
      <Setter Property="Height" Value="NaN" />
    </Style>
    <Style Selector="^:nolabel /template/ wpf|RibbonTwoLineText#TwoLineText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:noimage /template/ Image#PART_Image">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:collapsed">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#OuterBorder">
        <Setter Property="Background" Value="{DynamicResource $F.Invented.Ribbon.MouseOver.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.MouseOver.BorderBrush}" />
      </Style>
      <Style Selector="^ /template/ Border#InnerBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.Button.MouseOver.InnerBorderBrush}" />
      </Style>
    </Style>
    <Style Selector="^:focus-visible">
      <Style Selector="^ /template/ Border#OuterBorder">
        <Setter Property="Background" Value="{DynamicResource $F.Invented.Ribbon.Focused.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.Focused.BorderBrush}" />
      </Style>
      <Style Selector="^ /template/ Border#InnerBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.Button.MouseOver.InnerBorderBrush}" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource $F.Invented.Ribbon.Disabled.Foreground}" />
      <Style Selector="^ /template/ Image#PART_Image">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </Style>
    <Style Selector="^:checked">
      <Style Selector="^ /template/ Border#OuterBorder">
        <Setter Property="Background" Value="{DynamicResource $F.Invented.Ribbon.Checked.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.Checked.BorderBrush}" />
      </Style>
      <Style Selector="^ /template/ Border#InnerBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.ToggleButton.Checked.InnerBorderBrush}" />
      </Style>
    </Style>
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Border#OuterBorder">
        <Setter Property="Background" Value="{DynamicResource $F.Invented.Ribbon.Pressed.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.Pressed.BorderBrush}" />
      </Style>
      <Style Selector="^ /template/ Border#InnerBorder">
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#MiddleBorder">
      <Setter Property="Background" Value="{DynamicResource $F.Invented.Ribbon.HighlightedSelected.Background}" />
    </Style>
    <Style Selector="^:checked:focus-visible /template/ Border#MiddleBorder">
      <Setter Property="Background" Value="{DynamicResource $F.Invented.Ribbon.HighlightedSelected.Background}" />
    </Style>
    <Style Selector="^:incontrolgroup">
      <Style Selector="^ /template/ Border#OuterBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="^ /template/ Border#InnerBorder">
        <Setter Property="CornerRadius" Value="0" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
