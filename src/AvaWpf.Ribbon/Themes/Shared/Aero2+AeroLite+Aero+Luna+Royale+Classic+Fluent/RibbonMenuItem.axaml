<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- WPF RibbonMenuItem.xaml, [[Generic]]: side bar with image or check mark, header, submenu arrow column. -->
  <ControlTheme x:Key="{x:Type wpf:RibbonMenuItem}" TargetType="wpf:RibbonMenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="3,2,3,2" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="MainGrid">
          <Border Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{DynamicResource $F.Invented.Ribbon.Button.CornerRadius}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="22" Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
              </Grid.ColumnDefinitions>
              <Border Name="PART_SideBarBorder"
                      Margin="0,-1,0,-1"
                      BorderThickness="0,0,1,0"
                      Background="{DynamicResource $F.Invented.Ribbon.Background}"
                      BorderBrush="{DynamicResource $F.Invented.Ribbon.BorderBrush}">
                <Panel Name="SideBarOverlay" Background="{DynamicResource $F.Invented.Ribbon.MenuItem.Overlay}">
                  <Image Name="Image"
                         Width="16"
                         Height="16"
                         Margin="4,3,6,1"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Source="{TemplateBinding ImageSource}" />
                  <Border Name="CheckMarkBorder"
                          Background="{DynamicResource $F.Invented.Ribbon.Checked.Background}"
                          BorderBrush="{DynamicResource $F.Invented.Ribbon.Checked.BorderBrush}"
                          BorderThickness="1"
                          IsVisible="False"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="1"
                          Width="20"
                          Height="20"
                          CornerRadius="2">
                    <Path Name="CheckMark"
                          Margin="4,0,4,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Fill="{TemplateBinding Foreground}"
                          Stretch="Uniform"
                          Width="10"
                          Data="{DynamicResource $F.Invented.Ribbon.Glyph.CheckMark}" />
                  </Border>
                </Panel>
              </Border>
              <ContentPresenter Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True" />
              <Path Name="Arrow"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Fill="{TemplateBinding Foreground}"
                    Data="{DynamicResource $F.Invented.Ribbon.Glyph.RightArrow}" />
            </Grid>
          </Border>
          <Popup Name="PART_Popup"
                 VerticalOffset="-1"
                 Placement="RightEdgeAlignedTop"
                 IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 wpf:PopupAnimation.Kind="{DynamicResource SystemParameters.MenuPopupAnimation}">
            <wpf:SystemDropShadowChrome Name="Shadow" Margin="0,0,5,5">
              <Border Name="MenuBorder"
                      BorderBrush="{DynamicResource $F.Invented.Ribbon.BorderBrush}"
                      Background="{DynamicResource $F.Invented.Ribbon.Background}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource $F.Invented.Ribbon.Popup.CornerRadius}">
                <Border Name="SubMenuInnerBorder"
                        Background="{DynamicResource $F.Invented.Ribbon.DropDown.Background}"
                        CornerRadius="{DynamicResource $F.Invented.Ribbon.Popup.CornerRadius}">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  Margin="2"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  Grid.IsSharedSizeScope="True" />
                </Border>
              </Border>
            </wpf:SystemDropShadowChrome>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked">
      <Style Selector="^ /template/ Border#CheckMarkBorder">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Image#Image">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </Style>
    <Style Selector="^[ItemCount=0] /template/ Path#Arrow">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:selected /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource $F.Invented.Ribbon.MouseOver.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.MouseOver.BorderBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Border">
      <Setter Property="Background" Value="{DynamicResource $F.Invented.Ribbon.Pressed.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.Pressed.BorderBrush}" />
    </Style>
    <!-- WPF clears the side bar while the item is highlighted or pressed, so the highlight fills the whole row. -->
    <Style Selector="^:selected /template/ Border#PART_SideBarBorder, ^:pressed /template/ Border#PART_SideBarBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:selected /template/ Panel#SideBarOverlay, ^:pressed /template/ Panel#SideBarOverlay">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource $F.Invented.Ribbon.Disabled.Foreground}" />
      <Style Selector="^ /template/ Image#Image">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
