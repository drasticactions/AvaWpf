<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf">
  <!-- WPF RibbonControlGroup.xaml, [[Generic]]: the border is open on the right because each item draws its own right separator. -->
  <ControlTheme x:Key="{x:Type wpf:RibbonControlGroup}" TargetType="wpf:RibbonControlGroup">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="BorderBrush" Value="{DynamicResource $F.Invented.Ribbon.BorderBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,1,0,1" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="MainBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="1,1,0,1"
                CornerRadius="{DynamicResource $F.Invented.Ribbon.Button.CornerRadius}"
                UseLayoutRounding="True">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
