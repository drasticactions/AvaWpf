<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="https://github.com/avawpf"
                    xmlns:primitives="clr-namespace:AvaWpf.Ribbon.Primitives;assembly=AvaWpf.Ribbon">
  <!-- WPF RibbonTab.xaml, [[Generic]]. No horizontal tab scrolling: the groups shrink and collapse instead. -->
  <ControlTheme x:Key="{x:Type wpf:RibbonTab}" TargetType="wpf:RibbonTab">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <primitives:RibbonGroupsPanel />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="MainGrid" IsVisible="{TemplateBinding IsSelected}" ClipToBounds="True">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" HorizontalAlignment="Left" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
